'================================================================================Wizard Bridge
Sub SetPaperSizeDir
    Dim iPaperSize As Integer
    Dim iPaperDir  As Integer
    Select Case a_PaperSize
        Case A_PAPER_A3
            iPaperSize = 1
        Case A_PAPER_A4
            iPaperSize = 0
        Case A_PAPER_A5
            iPaperSize = 7
        Case A_PAPER_A6
            iPaperSize = 8
        Case A_PAPER_A6NEW
            iPaperSize = 9
        Case A_PAPER_B4
            iPaperSize = 3
        Case A_PAPER_B5
            iPaperSize = 2
        Case A_PAPER_B6
            iPaperSize = 10
        Case A_PAPER_B6NEW
            iPaperSize = 11
        Case A_PAPER_B40
            iPaperSize = 12
        Case A_PAPER_LETTER
            iPaperSize = 4
        Case A_PAPER_LEGAL
            iPaperSize = 5
        Case A_PAPER_80COL
            iPaperSize = 13
        Case A_PAPER_132COL
            iPaperSize = 14
        Case A_PAPER_USERDEF
'           iPaperSize = 
        Case Else
            iPaperSize = 0
    End Select
Step_SetPaperDir:
    Select Case a_PaperDir
        Case A_PAPER_LANDSCAPE
            iPaperDir = 1
        Case A_PAPER_PORTRAIT
            iPaperDir = 0
        Case Else
            Select Case a_CalType
                Case A_CALENDAR_MONTHSTD
                    a_PaperDir = A_PAPER_LANDSCAPE
                    Goto Step_SetPaperDir
                Case A_CALENDAR_MONTHCARD
                    a_PaperDir = A_PAPER_LANDSCAPE
                    Goto Step_SetPaperDir
                Case A_CALENDAR_MONTHIMG
                    a_PaperDir = A_PAPER_LANDSCAPE
                    Goto Step_SetPaperDir
                Case A_CALENDAR_DAY
                    a_PaperDir = A_PAPER_PORTRAIT
                    Goto Step_SetPaperDir
                Case A_CALENDAR_WEEK
                    a_PaperDir = A_PAPER_PORTRAIT
                    Goto Step_SetPaperDir
                Case A_CALENDAR_YEAR
                    a_PaperDir = A_PAPER_PORTRAIT
                    Goto Step_SetPaperDir
                Case Else
                    a_CalType = A_CALENDAR_MONTHSTD
                    Goto Step_SetPaperDir
            End Select
    End Select
    dmy = Hun70.PaperSize(-1, iPaperSize, 0, 0, iPaperDir, 0)
    If iPaperDir = 1 Then
        dmy = Hun70.MaxHorizontalZoom()
    Else
        dmy = Hun70.MaxVerticalZoom()
    End If
End Sub
