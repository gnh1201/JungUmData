Option Explicit

'a_CalType
Const A_CALENDAR_MONTHSTD  = 1
Const A_CALENDAR_MONTHCARD = 2
Const A_CALENDAR_MONTHIMG  = 3
Const A_CALENDAR_DAY       = 4
Const A_CALENDAR_WEEK      = 5
Const A_CALENDAR_YEAR      = 6

'a_PaperSize
Const A_PAPER_A3          = 1
Const A_PAPER_A4          = 2
Const A_PAPER_A5          = 3
Const A_PAPER_A6          = 4
Const A_PAPER_A6NEW       = 5
Const A_PAPER_B4          = 6
Const A_PAPER_B5          = 7
Const A_PAPER_B6          = 8
Const A_PAPER_B6NEW       = 9
Const A_PAPER_B40         = 10
Const A_PAPER_LETTER      = 11
Const A_PAPER_LEGAL       = 12
Const A_PAPER_80COL       = 13
Const A_PAPER_132COL      = 14
Const A_PAPER_USERDEF     = 15

'a_PaperDir
Const A_PAPER_LANDSCAPE   = 1
Const A_PAPER_PORTRAIT    = 2

'g_WizState
Const A_STATE_PREV        = 1
Const A_STATE_NEXT        = 2
Const A_STATE_MAKE        = 3
Const A_STATE_CANCEL      = 4

Global a_CalType        As Integer
Global a_PaperSize      As Integer
Global a_PaperDir       As Integer
Global a_StyleList(100) As String
Global a_StyleCount     As Integer
Global a_StyleSelect    As Integer
Global a_StyleFile(100) As String
Global a_Desc1          As String
Global a_Desc2          As String

Global a_Year1          As Integer
Global a_Month1         As Integer
Global a_Day1           As Integer
Global a_Year2          As Integer
Global a_Month2         As Integer
Global a_Day2           As Integer
Global a_CurrDoc        As Integer
Global a_Color          As Integer
Global a_Pims31Data     As Integer
Global a_Date           As Integer
Global a_Logo           As String

Global a_Image          As String

Global a_FileExt        As Object

Global a_CurDir         As String
Global a_Step           As Integer
Global a_bBtnPrev       As Integer
Global a_bBtnNext       As Integer
Global a_bBtnMake       As Integer
Global a_bBtnCancel     As Integer
Global g_WizState       As Integer

Global c_FrameID        As Integer

Global g_IsPimsInstalled As Integer

Function a_GetMonthDay(iYear As Integer, iMonth As Integer) As Integer

    Select Case iMonth
        Case 1
            a_GetMonthDay = 31
        Case 2
            If (iYear Mod 4) = 0 Then
                If (iYear Mod 100) = 0 Then
                    If (iYear Mod 400) = 0 Then
                        a_GetMonthDay = 29
                    Else
                        a_GetMonthDay = 28
                    End If
                Else
                    a_GetMonthDay = 29
                End If
            Else
                a_GetMonthDay = 28
            End If
        Case 3
            a_GetMonthDay = 31
        Case 4
            a_GetMonthDay = 30
        Case 5
            a_GetMonthDay = 31
        Case 6
            a_GetMonthDay = 30
        Case 7
            a_GetMonthDay = 31
        Case 8
            a_GetMonthDay = 31
        Case 9
            a_GetMonthDay = 30
        Case 10
            a_GetMonthDay = 31
        Case 11
            a_GetMonthDay = 30
        Case 12
            a_GetMonthDay = 31
    End Select

End Function

'--------------------------------------------------------------------------------TTI Walk
Const B_MAX_NUM_FILES = 100
Const B_MAX_NUM_ITEM  = 100
Const B_MAX_NUM_CHILD = 100

Global b_Files(B_MAX_NUM_FILES)                 As String
Global b_Count                                  As Integer
Global b_Item(B_MAX_NUM_ITEM)                   As String
Global b_Value(B_MAX_NUM_ITEM)                  As String
Global b_Parent(B_MAX_NUM_ITEM)                 As Integer
Global b_Child(B_MAX_NUM_ITEM, B_MAX_NUM_CHILD) As Integer

Sub DirWalk(strPath As String)
    Dim strDir  As String
    Dim strFile As String
    strDir = CurDir
    If Right(CurDir, 1) <> "\" Then
        strDir = strDir + "\"
    End If
    If Instr(strPath, ":") = 0 And Instr(strPath, "\\") = 0 Then   'No drive specified.
        strPath = strDir + strPath
    End If
    b_Count = 0
    strFile = Dir(strPath)
    Do While strFile <> "" And b_Count <= 100
        b_Files(b_Count) = strDir + strFile
        b_Count = b_Count + 1
        strFile = Dir
    Loop
End Sub

Sub GetItemAndValue(strLine As String, iDepth As Integer, strItem As String, strValue As String)
    Dim strLineCopy As String
    Dim iLenOrg     As Integer
    Dim iAssignPos  As Integer
    strLineCopy = strLine
    iLenOrg = Len(strLineCopy)
    strLineCopy = LTrim(strLineCopy)
    iDepth = iLenOrg - Len(strLineCopy)
    iAssignPos = Instr(strLineCopy, "=")
    If iAssignPos = 0 Then
        strItem  = RTrim(strLineCopy)
        strValue = ""
    Else
        strItem  = RTrim(Left(strLineCopy, iAssignPos - 1))
        strValue = RTrim(LTrim(Mid(strLineCopy, iAssignPos + 1)))
    End If
End Sub

Function CheckTtiHeader(strFile As String, strItem As String, strValue As String) As Integer
    Dim strItemCopy  As String
    Dim strValueCopy As String
    Dim iRetValue    As Integer
    Dim strLine      As String
    Dim iDepth       As Integer   'Header이므로 사용안함
    Dim strItemTmp   As String
    Dim strValueTmp  As String
    strItemCopy  = RTrim(LTrim(strItem))
    strValueCopy = RTrim(LTrim(strValue))
    iRetValue    = 0
    Open strFile for Input As #1
    Line Input #1, strLine
    Do While (Not Eof(1)) And strLine <> ""
        GetItemAndValue strLine, iDepth, strItemTmp, strValueTmp
        If strItemTmp = strItemCopy And strValueTmp = strValueCopy Then
            iRetValue = 1
            Exit Do
        Else
            Line Input #1, strLine
        End If
    Loop
    Close #1
    CheckTtiHeader = iRetValue
End Function

Function GetTtiHeaderValue(strFile As String, strItem As String) As String
    Dim strItemCopy  As String
    Dim strRetValue  As String
    Dim strLine      As String
    Dim iDepth       As Integer   'Header이므로 사용안함
    Dim strItemTmp   As String
    Dim strValueTmp  As String
    strItemCopy  = RTrim(LTrim(strItem))
    Open strFile for Input As #1
    strLine = "Empty"
    Do While (Not Eof(1)) And strLine <> ""
        Line Input #1, strLine
        GetItemAndValue strLine, iDepth, strItemTmp, strValueTmp
        If strItemTmp = strItemCopy Then
            strRetValue = strValueTmp
            Exit Do
        End If
    Loop
    Close #1
    GetTtiHeaderValue = strRetValue
End Function

Function GetTtiBodyValue(strFile As String, strItem As String) As String
    Dim strItemCopy  As String
    Dim strRetValue  As String
    Dim strLine      As String
    Dim iDepth       As Integer   'Header이므로 사용안함
    Dim strItemTmp   As String
    Dim strValueTmp  As String
    strItemCopy  = RTrim(LTrim(strItem))
    Open strFile for Input As #1
    strLine = "Empty"
    Do While (Not Eof(1)) And strLine <> ""   'Skip Header
        Line Input #1, strLine
    Loop
    If Not Eof(1) Then
        strLine = "Empty"
        Do While (Not Eof(1)) And strLine <> ""
            Line Input #1, strLine
            GetItemAndValue strLine, iDepth, strItemTmp, strValueTmp
            If strItemTmp = strItemCopy Then
                strRetValue = strValueTmp
                Exit Do
            End If
        Loop
    End If
    Close #1
    GetTtiBodyValue = strRetValue
End Function
'--------------------------------------------------------------------------------TTI Walk

Function GetArrListStyle(iListStyleID As Integer) As Integer

    '------------------------------------------------------------
    ' Header에 default라고 명시된 item index를 return한다.
    '------------------------------------------------------------
    Dim iIndex            As Integer
  ReDim ArrListStyle(100) As String
    Dim strOwner          As String
    Dim strValue          As String
    Dim iCount            As Integer
    Dim iSelect           As Integer

    Select Case a_CalType
        Case A_CALENDAR_DAY
            strOwner = "Hun70 Calendar-Day"
        Case A_CALENDAR_WEEK
            strOwner = "Hun70 Calendar-Week"
        Case A_CALENDAR_MONTHSTD
            strOwner = "Hun70 Calendar-MonthStd"
        Case A_CALENDAR_MONTHCARD
            strOwner = "Hun70 Calendar-MonthCard"
        Case A_CALENDAR_MONTHIMG
            strOwner = "Hun70 Calendar-MonthImg"
        Case A_CALENDAR_YEAR
            strOwner = "Hun70 Calendar-Year"
    End Select
    iCount  = 0
    iSelect = 0

    DirWalk "*.cty"

    For iIndex = 0 To b_Count - 1

        If CheckTtiHeader(b_Files(iIndex), "Owner", strOwner) = 1 Then
            strValue = GetTtiHeaderValue(b_Files(iIndex), "Description")
            If strValue <> "" Then
                ArrListStyle(iCount) = strValue
                a_StyleFile(iCount)  = b_Files(iIndex)
                strValue = GetTtiHeaderValue(b_Files(iIndex), "Default")
                If strValue = "TRUE" Then
                    iSelect = iCount
                End If
                iCount = iCount + 1
            End If
        End If

    Next iIndex

    If iCount > 0 Then
        ReDim Preserve ArrListStyle(iCount - 1)
    Else
        ReDim ArrListStyle(0)
    End If
    DlgListBoxArray iListStyleID, ArrListStyle

    a_StyleCount    = iCount
    '----------------------------------------------------------------------
    ' a_StyleSelect는 이 함수를 부른 곳에서 리턴값을 가지고 수정한다.
    '----------------------------------------------------------------------

    '----------------------------------------
    ' May be default item.
    '----------------------------------------
    GetArrListStyle = iSelect

End Function

Sub LoadStyle(strFile As String)

    Dim strPaperSize  As String
    Dim strPaperDir   As String
    Dim strColor      As String
    Dim strPims31Data As String
    Dim strDate       As String
    Dim strLogo       As String
    Dim strImage      As String

    strPaperSize  = GetTtiBodyValue(strFile, "PaperSize")
    strPaperDir   = GetTtiBodyValue(strFile, "PaperDir")
    strColor      = GetTtiBodyValue(strFile, "Color")
    strPims31Data = GetTtiBodyValue(strFile, "Pims31Data")
    strDate       = GetTtiBodyValue(strFile, "Date")
    strLogo       = GetTtiBodyValue(strFile, "Logo")
    strImage      = GetTtiBodyValue(strFile, "Image")

    Select Case strPaperSize
        Case "A3"
            a_PaperSize = A_PAPER_A3
        Case "A4"
            a_PaperSize = A_PAPER_A4
        Case "A5"
            a_PaperSize = A_PAPER_A5
        Case "A6"
            a_PaperSize = A_PAPER_A6
        Case "A6신"
            a_PaperSize = A_PAPER_A6NEW
        Case "B4"
            a_PaperSize = A_PAPER_B4
        Case "B5"
            a_PaperSize = A_PAPER_B5
        Case "B6"
            a_PaperSize = A_PAPER_B6
        Case "B6신"
            a_PaperSize = A_PAPER_B6NEW
        Case "B40"
            a_PaperSize = A_PAPER_B40
        Case "Letter"
            a_PaperSize = A_PAPER_LETTER
        Case "Legal"
            a_PaperSize = A_PAPER_LEGAL
        Case "80컬럼"
            a_PaperSize = A_PAPER_80COL
        Case "132컬럼"
            a_PaperSize = A_PAPER_132COL
        Case "사용자정의"
            a_PaperSize = A_PAPER_USERDEF
        Case Else
            '----------------------------------------
            ' Default Value
            '----------------------------------------
            strPaperSize = "A4"
            a_PaperSize  = A_PAPER_A4
    End Select

    Select Case strPaperDir
        Case "Landscape"
            a_PaperDir = A_PAPER_LANDSCAPE
        Case "Portrait"
            a_PaperDir = A_PAPER_PORTRAIT
        Case Else
            '----------------------------------------
            ' Default Value
            '----------------------------------------
            strPaperDir = "Portrait"
            a_PaperDir  = A_PAPER_PORTRAIT
    End Select

    Select Case strColor
        Case "On"
            a_Color = 1
        Case "Off"
            a_Color = 0
        Case Else
            '----------------------------------------
            ' Default Value
            '----------------------------------------
            strColor = "On"
            a_Color  = 1
    End Select

    Select Case strPims31Data
        Case "On"
            a_Pims31Data = 1
        Case "Off"
            a_Pims31Data = 0
        Case Else
            '----------------------------------------
            ' Default Value
            '----------------------------------------
            strPims31Data = "Off"
            a_Pims31Data  = 0
    End Select

    If a_CalType = A_CALENDAR_MONTHSTD Or a_CalType = A_CALENDAR_MONTHCARD Or a_CalType = A_CALENDAR_WEEK Then
        a_Date = Val(Trim(strDate))
    Else
        a_Date = -1
    End If

    If a_CalType = A_CALENDAR_MONTHSTD Or a_CalType = A_CALENDAR_MONTHCARD Or a_CalType = A_CALENDAR_MONTHIMG Then
        If Instr(strLogo, "%PATH%") > 0 Then
            strLogo = Left(strLogo, Instr(strLogo, "%PATH%") - 1) + a_CurDir + Mid(strLogo, Instr(strLogo, "%PATH%") + 6)
        End If
        a_Logo = strLogo
    Else
        a_Logo = ""
    End If

    If a_CalType = A_CALENDAR_MONTHIMG Then
        If strImage = "" Then
            If Month(Now()) = 3 Or Month(Now()) = 4 Or Month(Now()) = 5 Then
                strImage = "%PATH%봄.bmp"
            End If
            If Month(Now()) = 6 Or Month(Now()) = 7 Or Month(Now()) = 8 Then
                strImage = "%PATH%여름.bmp"
            End If
            If Month(Now()) = 9 Or Month(Now()) = 10 Or Month(Now()) = 11 Then
                strImage = "%PATH%가을.bmp"
            End If
            If Month(Now()) = 12 Or Month(Now()) = 1 Or Month(Now()) = 2 Then
                strImage = "%PATH%겨울.bmp"
            End If
            If Instr(strImage, "%PATH%") > 0 Then
                strImage = Left(strImage, Instr(strImage, "%PATH%") - 1) + a_CurDir + Mid(strImage, Instr(strImage, "%PATH%") + 6)
            End If
        End If
        a_Image = strImage
    Else
        a_Image = ""
    End If

End Sub

Sub GetDesc(strDesc1 As String, strDesc2 As String)

    Dim strDesc(1)    As String
    Dim iDescIdx      As Integer
    Dim strPaperSize  As String
    Dim strPaperDir   As String
    Dim strColor      As String
    Dim strPims31Data As String

    iDescIdx = 0
    strDesc(0) = ""
    strDesc(1) = ""
    strDesc(iDescIdx) = "용지는 "

    Select Case a_PaperSize
        Case A_PAPER_A3
            strPaperSize = "A3"
        Case A_PAPER_A4
            strPaperSize = "A4"
        Case A_PAPER_A5
            strPaperSize = "A5"
        Case A_PAPER_A6
            strPaperSize = "A6"
        Case A_PAPER_A6NEW
            strPaperSize = "A6신"
        Case A_PAPER_B4
            strPaperSize = "B4"
        Case A_PAPER_B5
            strPaperSize = "B5"
        Case A_PAPER_B6
            strPaperSize = "B6"
        Case A_PAPER_B6NEW
            strPaperSize = "B6신"
        Case A_PAPER_B40
            strPaperSize = "B40"
        Case A_PAPER_LETTER
            strPaperSize = "Letter"
        Case A_PAPER_LEGAL
            strPaperSize = "Legal"
        Case A_PAPER_80COL
            strPaperSize = "80컬럼"
        Case A_PAPER_132COL
            strPaperSize = "132컬럼"
        Case A_PAPER_USERDEF
            strPaperSize = "사용자정의"
        Case Else
            a_PaperSize  = A_PAPER_A4
            strPaperSize = "A4"
    End Select

    strDesc(iDescIdx) = strDesc(iDescIdx) + strPaperSize + "-"

    Select Case a_PaperDir
        Case A_PAPER_LANDSCAPE
            strPaperDir = "가로"
        Case A_PAPER_PORTRAIT
            strPaperDir = "세로"
        Case Else
            a_PaperDir = A_PAPER_PORTRAIT
            strPaperDir = "가로"
    End Select

    strDesc(iDescIdx) = strDesc(iDescIdx) + strPaperDir

    Select Case a_Color
        Case 1
            strColor = ", 컬러 인쇄"
        Case 0
            strColor = ", 흑백 인쇄"
        Case Else
            a_Color = 1
            strColor = ", 컬러 인쇄"
    End Select

    strDesc(iDescIdx) = strDesc(iDescIdx) + strColor

    Select Case a_Pims31Data
        Case 1
            iDescIdx = iDescIdx + 1
            strPims31Data = ", 훈민 스케쥴러 데이터를 읽어"
        Case 0
            strPims31Data = "로"
        Case Else
            a_Pims31Data = 0
            strPims31Data = "로"
    End Select

    strDesc(iDescIdx) = strDesc(iDescIdx) + strPims31Data

    strDesc(iDescIdx) = strDesc(iDescIdx) + " 작성합니다."

    strDesc1 = strDesc(0)
    strDesc2 = strDesc(1)

End Sub

Sub ResetTypeDlg(iPicExamID, iBtnPrevID, iBtnNextID, iBtnMakeID, iBtnCancelID, iOptGrpTypeID, iOptGrpDirID, iListStyleID, iTextDesc1ID, iTextDesc2ID As Integer)

    Dim strPre As String

    '------------------------------------------------------------
    ' iPicExamID는 a_CalType의 verification이 끝나야 사용할 수
    ' 있으므로 뒤로 옮겼다.
    '------------------------------------------------------------
    If iBtnPrevID >= 0 Then
        If a_bBtnPrev <> 0 And a_bBtnPrev <> 1 Then
            a_bBtnPrev = 0
        End If
        DlgEnable iBtnPrevID, a_bBtnPrev
    End If

    If iBtnNextID >= 0 Then
        If a_bBtnNext <> 0 And a_bBtnNext <> 1 Then
            a_bBtnNext = 0
        End If
        DlgEnable iBtnNextID, a_bBtnNext
    End If

    If iBtnMakeID >= 0 Then
        If a_bBtnMake <> 0 And a_bBtnMake <> 1 Then
            a_bBtnMake = 0
        End If
        DlgEnable iBtnMakeID, a_bBtnMake
    End If

    If iBtnCancelID >= 0 Then
        If a_bBtnCancel <> 0 And a_bBtnCancel <> 1 Then
            a_bBtnCancel = 0
        End If
        DlgEnable iBtnCancelID, a_bBtnCancel
    End If

    If iOptGrpTypeID >= 0 Then
        Select Case a_CalType
            Case A_CALENDAR_DAY
            Case A_CALENDAR_WEEK
            Case A_CALENDAR_MONTHSTD
            Case A_CALENDAR_MONTHCARD
            Case A_CALENDAR_MONTHIMG
            Case A_CALENDAR_YEAR
            Case Else
                a_CalType = A_CALENDAR_MONTHSTD
        End Select
        DlgValue iOptGrpTypeID, a_CalType - 1
    End If

    If iListStyleID >= 0 Then
        Dim iSelect As Integer
        iSelect = GetArrListStyle(iListStyleID)
        If a_StyleSelect = -1 Then
            a_StyleSelect = iSelect
        End If
        DlgValue iListStyleID, a_StyleSelect
        LoadStyle a_StyleFile(a_StyleSelect)
        '------------------------------------------------------------!WARNING!
        ' ListStyle가 바뀌면 a_StyleSelect도 바뀌고
        ' TextDesc1,TextDesc2도 바뀌기 때문에 iTextDesc1ID,iTextDesc2ID도
        ' 같이 지정해야 한다.
        '------------------------------------------------------------
    End If

    If iOptGrpDirID >= 0 Then
        '--------------------------------------------------
        ' a_PaperDir은 위에서 LoadStyle한 후 변경된다.
        '--------------------------------------------------
        Select Case a_PaperDir
            Case A_PAPER_LANDSCAPE
            Case A_PAPER_PORTRAIT
            Case Else
                a_PaperDir = A_PAPER_LANDSCAPE
        End Select
        DlgValue iOptGrpDirID, a_PaperDir - 1
    End If

    If iTextDesc1ID >= 0 And iTextDesc2ID >= 0 Then
        GetDesc a_Desc1, a_Desc2
        DlgText iTextDesc1ID, a_Desc1
        DlgText iTextDesc2ID, a_Desc2
    End If

    If iPicExamID >= 0 Then
        '------------------------------------------------------------
        ' 사용자가 지정한 여러 Calendar 정보를 참고로 그림을 바꾼다.
        '------------------------------------------------------------
        Select Case a_PaperDir
            Case A_PAPER_LANDSCAPE
                strPre = "l"
            Case A_PAPER_PORTRAIT
                strPre = "p"
        End Select
        Select Case a_CalType
            Case A_CALENDAR_DAY
                DlgSetPicture iPicExamID, a_CurDir + strPre + "d.bmp", 0
            Case A_CALENDAR_WEEK
                DlgSetPicture iPicExamID, a_CurDir + strPre + "w.bmp", 0
            Case A_CALENDAR_MONTHSTD
                DlgSetPicture iPicExamID, a_CurDir + strPre + "mt.bmp", 0
            Case A_CALENDAR_MONTHCARD
                DlgSetPicture iPicExamID, a_CurDir + strPre + "mf.bmp", 0
            Case A_CALENDAR_MONTHIMG
                DlgSetPicture iPicExamID, a_CurDir + strPre + "mi.bmp", 0
            Case A_CALENDAR_YEAR
                DlgSetPicture iPicExamID, a_CurDir + strPre + "y.bmp", 0
        End Select
    End If

End Sub

Function SetTypeDlgProc(identifier$, action, suppvalue)

    Dim iPicExamID       As Integer
    Dim iBtnPrevID       As Integer
    Dim iBtnNextID       As Integer
    Dim iBtnMakeID       As Integer
    Dim iBtnCancelID     As Integer

    Dim iOptGrpTypeID    As Integer
    Dim iOptGrpDirID     As Integer
    Dim iListStyleID     As Integer
    Dim iTextDesc1ID     As Integer
    Dim iTextDesc2ID     As Integer

    iPicExamID    = DlgControlID("PicExam")
    iBtnPrevID    = DlgControlID("BtnPrev")
    iBtnNextID    = DlgControlID("BtnNext")
    iBtnMakeID    = DlgControlID("BtnMake")
    iBtnCancelID  = DlgControlID("BtnCancel")

    iOptGrpTypeID = DlgControlID("OptGrpType")
    iOptGrpDirID  = DlgControlID("OptGrpDir")
    iListStyleID  = DlgControlID("ListStyle")
    iTextDesc1ID  = DlgControlID("TextDesc1")
    iTextDesc2ID  = DlgControlID("TextDesc2")

    SetTypeDlgProc = 1

    Select Case action

        Case 1

            ResetTypeDlg iPicExamID, iBtnPrevID, iBtnNextID, iBtnMakeID, iBtnCancelID, iOptGrpTypeID, iOptGrpDirID, iListStyleID, iTextDesc1ID, iTextDesc2ID

        Case 2

            If identifier$ = "BtnPrev" Then
                g_WizState = A_STATE_PREV
                SetTypeDlgProc = 0
            End If
            If identifier$ = "BtnNext" Then
                g_WizState = A_STATE_NEXT
                SetTypeDlgProc = 0
            End If
            If identifier$ = "BtnMake" Then
                g_WizState = A_STATE_MAKE
                SetTypeDlgProc = 0
            End If
            If identifier$ = "BtnCancel" Then
                g_WizState = A_STATE_CANCEL
                SetTypeDlgProc = 0
            End If

            If identifier$ = "OptMonthStd" Then
                a_CalType = A_CALENDAR_MONTHSTD
                a_StyleSelect = -1
                ResetTypeDlg iPicExamID, -1, -1, -1, -1, iOptGrpTypeID, iOptGrpDirID, iListStyleID, iTextDesc1ID, iTextDesc2ID
            End If
            If identifier$ = "OptMonthCard" Then
                a_CalType = A_CALENDAR_MONTHCARD
                a_StyleSelect = -1
                ResetTypeDlg iPicExamID, -1, -1, -1, -1, iOptGrpTypeID, iOptGrpDirID, iListStyleID, iTextDesc1ID, iTextDesc2ID
            End If
            If identifier$ = "OptMonthImg" Then
                a_CalType = A_CALENDAR_MONTHIMG
                a_StyleSelect = -1
                ResetTypeDlg iPicExamID, -1, -1, -1, -1, iOptGrpTypeID, iOptGrpDirID, iListStyleID, iTextDesc1ID, iTextDesc2ID
            End If
            If identifier$ = "OptDay" Then
                a_CalType = A_CALENDAR_DAY
                a_StyleSelect = -1
                ResetTypeDlg iPicExamID, -1, -1, -1, -1, iOptGrpTypeID, iOptGrpDirID, iListStyleID, iTextDesc1ID, iTextDesc2ID
            End If
            If identifier$ = "OptWeek" Then
                a_CalType = A_CALENDAR_WEEK
                a_StyleSelect = -1
                ResetTypeDlg iPicExamID, -1, -1, -1, -1, iOptGrpTypeID, iOptGrpDirID, iListStyleID, iTextDesc1ID, iTextDesc2ID
            End If
            If identifier$ = "OptYear" Then
                a_CalType = A_CALENDAR_YEAR
                a_StyleSelect = -1
                ResetTypeDlg iPicExamID, -1, -1, -1, -1, iOptGrpTypeID, iOptGrpDirID, iListStyleID, iTextDesc1ID, iTextDesc2ID
            End If
            If identifier$ = "OptLandscape" Then
                a_PaperDir = A_PAPER_LANDSCAPE
                ResetTypeDlg iPicExamID, -1, -1, -1, -1, -1, -1, -1, iTextDesc1ID, iTextDesc2ID
            End If
            If identifier$ = "OptPortrait" Then
                a_PaperDir = A_PAPER_PORTRAIT
                ResetTypeDlg iPicExamID, -1, -1, -1, -1, -1, -1, -1, iTextDesc1ID, iTextDesc2ID
            End If
            If identifier$ = "ListStyle" Then
                a_StyleSelect = suppvalue
                DlgValue iListStyleID, a_StyleSelect
                LoadStyle a_StyleFile(a_StyleSelect)
                ResetTypeDlg iPicExamID, -1, -1, -1, -1, -1, iOptGrpDirID, -1, iTextDesc1ID, iTextDesc2ID
            End If

        Case 3
        Case 4
        Case 5

    End Select

End Function

