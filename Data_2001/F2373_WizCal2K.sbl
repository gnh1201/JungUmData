Sub ResetImageDlg(iPicExamID, iBtnPrevID, iBtnNextID, iBtnMakeID, iBtnCancelID, iPicImageID, iEditImgPathID As Integer)

    Dim strPre As String

    If iBtnPrevID >= 0 Then
        If a_bBtnPrev <> 0 And a_bBtnPrev <> 1 Then
            a_bBtnPrev = 0
        End If
        DlgEnable iBtnPrevID, a_bBtnPrev
    End If

    If iBtnNextID >= 0 Then
        If a_bBtnNext <> 0 And a_bBtnNext <> 1 Then
            a_bBtnNext = 0
        End If
        DlgEnable iBtnNextID, a_bBtnNext
    End If

    If iBtnMakeID >= 0 Then
        If a_bBtnMake <> 0 And a_bBtnMake <> 1 Then
            a_bBtnMake = 0
        End If
        DlgEnable iBtnMakeID, a_bBtnMake
    End If

    If iBtnCancelID >= 0 Then
        If a_bBtnCancel <> 0 And a_bBtnCancel <> 1 Then
            a_bBtnCancel = 0
        End If
        DlgEnable iBtnCancelID, a_bBtnCancel
    End If

    If iPicImageID >= 0 Then
        DlgSetPicture iPicImageID, a_Image, 0
    End If

    If iEditImgPathID >= 0 Then
        DlgText iEditImgPathID, a_Image
    End If

    If iPicExamID >= 0 Then
        '------------------------------------------------------------
        ' 사용자가 지정한 여러 Calendar 정보를 참고로 그림을 바꾼다.
        '------------------------------------------------------------
        Select Case a_PaperDir
            Case A_PAPER_LANDSCAPE
                strPre = "l"
            Case A_PAPER_PORTRAIT
                strPre = "p"
        End Select
        Select Case a_CalType
            Case A_CALENDAR_DAY
                DlgSetPicture iPicExamID, a_CurDir + strPre + "d.bmp", 0
            Case A_CALENDAR_WEEK
                DlgSetPicture iPicExamID, a_CurDir + strPre + "w.bmp", 0
            Case A_CALENDAR_MONTHSTD
                DlgSetPicture iPicExamID, a_CurDir + strPre + "mt.bmp", 0
            Case A_CALENDAR_MONTHCARD
                DlgSetPicture iPicExamID, a_CurDir + strPre + "mf.bmp", 0
            Case A_CALENDAR_MONTHIMG
                DlgSetPicture iPicExamID, a_CurDir + strPre + "mi.bmp", 0
            Case A_CALENDAR_YEAR
                DlgSetPicture iPicExamID, a_CurDir + strPre + "y.bmp", 0
        End Select
    End If

End Sub

Function SetImageDlgProc(identifier$, action, suppvalue)

    Dim iPicExamID       As Integer
    Dim iBtnPrevID       As Integer
    Dim iBtnNextID       As Integer
    Dim iBtnMakeID       As Integer
    Dim iBtnCancelID     As Integer

    Dim iPicImageID      As Integer
    Dim iEditImgPathID   As Integer
    Dim iBtnBrowseID     As Integer
    Dim iBtnSaveID       As Integer

    iPicExamID     = DlgControlID("PicExam")
    iBtnPrevID     = DlgControlID("BtnPrev")
    iBtnNextID     = DlgControlID("BtnNext")
    iBtnMakeID     = DlgControlID("BtnMake")
    iBtnCancelID   = DlgControlID("BtnCancel")

    iPicImageID    = DlgControlID("PicImage")
    iEditImgPathID = DlgControlID("EditImgPath")
    iBtnBrowseID   = DlgControlID("BtnBrowse")
    iBtnSaveID     = DlgControlID("BtnSave")

    SetImageDlgProc = 1

    Select Case action

        Case 1

            ResetImageDlg iPicExamID, iBtnPrevID, iBtnNextID, iBtnMakeID, iBtnCancelID, iPicImageID, iEditImgPathID

        Case 2

            If identifier$ = "BtnPrev" Then
                g_WizState = A_STATE_PREV
                SetImageDlgProc = 0
            End If
            If identifier$ = "BtnNext" Then
                g_WizState = A_STATE_NEXT
                SetImageDlgProc = 0
            End If
            If identifier$ = "BtnMake" Then
                g_WizState = A_STATE_MAKE
                SetImageDlgProc = 0
            End If
            If identifier$ = "BtnCancel" Then
                g_WizState = A_STATE_CANCEL
                SetImageDlgProc = 0
            End If

            If identifier$ = "BtnBrowse" Then
                a_Image = a_FileExt.FileDialog(1, "*.bmp", "", "Image Files (*.bmp)|*.bmp|All Files (*.*)|*.*||")
                ResetImageDlg -1, -1, -1, -1, -1, iPicImageID, iEditImgPathID
            End If

            If identifier$ = "BtnSave" Then
                WriteCty
            End If

        Case 3

            If identifier$ = "EditImgPath" Then
                a_Image = DlgText(iEditImgPathID)
                ResetImageDlg -1, -1, -1, -1, -1, iPicImageID, iEditImgPathID
            End If

        Case 4
        Case 5

    End Select

End Function

Sub SetImage

    Begin Dialog SetImageDlg 288, 192, "달력 만들기 - 그림지정", .SetImageDlgProc

        Picture      4,   4, 100, 150, a_CurDir + "lmt.bmp", 0, .PicExam
        Picture      4, 152, 280,  16, a_CurDir + "Sep.bmp", 0, .PicSep
        PushButton  34, 172,  50,  14, "<이전" , .BtnPrev
        PushButton  90, 172,  50,  14, "다음>" , .BtnNext
        PushButton 146, 172,  50,  14, "만들기", .BtnMake
        PushButton 202, 172,  50,  14, "취소"  , .BtnCancel

        Text 112, 4, 168, 8, Trim(Str(a_Step)) + ". 그림을 지정합니다."

        Picture    132,  16, 128, 100, a_CurDir + "Image.bmp", 0, .PicImage
        TextBox    112, 120, 124,  12, .EditImgPath
        PushButton 240, 120,  40,  12, "찾아보기..."       , .BtnBrowse
        PushButton 216, 136,  64,  12, "서식파일로 저장...", .BtnSave

    End Dialog

    Dim DlgSetImage As SetImageDlg

    Dialog DlgSetImage

End Sub

Sub Wizard

    Set a_FileExt = CreateObject("HBAEXT2K.FILEEXT")

    '----------------------------------------
    ' Init system variable
    '----------------------------------------
    a_CurDir = CurDir
    If Right(a_CurDir, 1) <> "\" Then
        a_CurDir = a_CurDir + "\"
    End If
    a_Step = 1

    '----------------------------------------
    ' Init application variable
    '----------------------------------------
    a_CalType   = A_CALENDAR_MONTHSTD
    a_PaperSize = A_PAPER_A4
    a_PaperDir  = A_PAPER_LANDSCAPE

    a_StyleSelect = -1

    a_Year1     = Year(Now)
    a_Month1    = Month(Now)
    a_Day1      = Day(Now)
    a_Year2     = a_Year1
    a_Month2    = a_Month1
    a_Day2      = a_Day1
    a_Date      = 0
    a_Logo      = a_CurDir + "SamsungLogo.gif"   'Reset by LoadStyle

Step_SetType:

    '----------------------------------------
    ' Init step
    '----------------------------------------
    a_bBtnPrev   = 0
    a_bBtnNext   = 1
    a_bBtnMake   = 1
    a_bBtnCancel = 1

    SetType

    Select Case g_WizState
'       Case A_STATE_PREV
        Case A_STATE_NEXT
            a_Step = a_Step + 1
            Goto Step_SetOption
        Case A_STATE_MAKE
            Goto Step_Make
        Case A_STATE_CANCEL
            Goto Step_Cancel
    End Select
    Goto Step_Cancel

Step_SetOption:

    '----------------------------------------
    ' Init step
    '----------------------------------------
    a_bBtnPrev   = 1
    Select Case a_CalType
        Case A_CALENDAR_MONTHIMG
            a_bBtnNext = 1
        Case Else
            a_bBtnNext = 0
    End Select
    a_bBtnMake   = 1
    a_bBtnCancel = 1

    SetOption

    Select Case g_WizState
        Case A_STATE_PREV
            a_Step = a_Step - 1
            Goto Step_SetType
        Case A_STATE_NEXT
            Select Case a_CalType
                Case A_CALENDAR_MONTHIMG
                    a_Step = a_Step + 1
                    Goto Step_SetImage
'               Case Else
            End Select
        Case A_STATE_MAKE
            Goto Step_Make
        Case A_STATE_CANCEL
            Goto Step_Cancel
    End Select
    Goto Step_Cancel

Step_SetImage:

    '----------------------------------------
    ' Init step
    '----------------------------------------
    a_bBtnPrev   = 1
    a_bBtnNext   = 0
    a_bBtnMake   = 1
    a_bBtnCancel = 1

    SetImage

    Select Case g_WizState
        Case A_STATE_PREV
            a_Step = a_Step - 1
            Goto Step_SetOption
'       Case A_STATE_NEXT
        Case A_STATE_MAKE
            Goto Step_Make
        Case A_STATE_CANCEL
            Goto Step_Cancel
    End Select
    Goto Step_Cancel

Step_Make:

Step_Cancel:

End Sub

