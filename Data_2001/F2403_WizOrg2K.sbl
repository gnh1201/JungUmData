Function MyInstr(strSrc As String, strSub As String) As Integer

    Dim iI

    MyInstr = 0   
    For iI = 1 To Len(strSrc) - Len(strSub) + 1
        If Mid(strSrc, iI, Len(strSub)) = strSub Then
            MyInstr = iI
            Exit For
        End If
    Next iI

End Function



Function GetStringLineCount(strText As String) As Integer

    Dim iL  As Integer
    Dim iC  As Integer
    Dim iI  As Integer

    iL = 1
    iC = Len(strText)

    For iI = 1 To iC
        If Mid(strText, iI, 1) = Chr(10) Then
            iL = iL + 1
        End If
    Next iI

    GetStringLineCount = iL

End Function



Function MakeListOrgItem(iIndex As Integer) As String

    Dim strItem     As String
    Dim strChar     As String
    Dim iI          As Integer
    Dim iJ          As Integer
    Dim iLevel(MAX_NUM_DEPTH2)  As Integer

    strItem = ""

    If ListOrgContent(iIndex) = "" Then

        For iI = 0 To ListOrgCount - 1
            For iJ = ListOrgDepth(iI) + 1 To (MAX_NUM_DEPTH - 1)
                If iLevel(iJ) = 0 Then
                    Exit For
                End If
                iLevel(iJ) = 0
            Next iJ
            iLevel(ListOrgDepth(iI)) = iLevel(ListOrgDepth(iI)) + 1
            If iI = iIndex Then
                For iJ = 1 To (MAX_NUM_DEPTH - 1)
                    If iLevel(iJ) = 0 Then
                        Exit For
                    End If
                    If iJ = 1 Then
                        strItem = strItem + " "
                    Else
                        strItem = strItem + "-"
                    End If
                    strItem = strItem + Str(iLevel(iJ))
                Next iJ
                Exit For
            End If
        Next iI

        MakeListOrgItem = Space(ListOrgDepth(iIndex) * 2) + strItem
'       MakeListOrgItem = Space(ListOrgDepth(iIndex) * 2) + LTrim(Str(iIndex))

    Else

        iC = Len(ListOrgContent(iIndex))

        For iI = 1 To iC
            strChar = Mid(ListOrgContent(iIndex), iI, 1)
            If strChar = "@" Then
                strChar = ""
                iI = iI + 1
            End If
            If strChar = Chr(10) Or strChar = Chr(13) Then
                Exit For ' end of line.
            End If
            strItem = strItem + strChar
        Next iI

        MakeListOrgItem = Space(ListOrgDepth(iIndex) * 2) + strItem

    End If

End Function



Function InsertItem(iIndex, iDepth, strLabel$, strContent$)

    Dim iListOrgID      As Integer
    Dim iC              As Integer
    Dim iI              As Integer
'   Dim iJ              As Integer
'   Dim iLevel(MAX_NUM_DEPTH - 1)      As Integer
  ReDim ListOrgArray(0) As String

    iListOrgID = DlgControlId("ListOrg")
    iC         = DlgListBoxArray(iListOrgID)

    If iIndex < 0 Or iIndex > iC Then
        Goto Exit_InsertItem
    End If
    If iIndex >= MAX_NUM_ITEM Then
        Goto Exit_InsertItem
    End If

    If iIndex < iC Then 'Append가 아니면...
        For iI = iC - 1 To iIndex Step -1
            ListOrgDepth(iI + 1)   = ListOrgDepth(iI)
            ListOrgSize(iI + 1)    = ListOrgSize(iI)
            ListOrgContent(iI + 1) = ListOrgContent(iI)
        Next iI
    End If

    ListOrgDepth(iIndex)   = iDepth
'   ListOrgSize(iIndex)    = strLabel$
    ListOrgSize(iIndex)    = 0 '새 아이템의 FrameSize는 e_iFrameSize(0)이다.
    ListOrgContent(iIndex) = strContent$

    ListOrgCount = iC + 1

    ReDim ListOrgArray(iC)

    For iI = 0 To iC
'       For iJ = ListOrgDepth(iI) + 1 To (MAX_NUM_DEPTH - 1)
'           If iLevel(iJ) = 0 Then
'               Exit For
'           End If
'           iLevel(iJ) = 0
'       Next iJ
'       iLevel(ListOrgDepth(iI)) = iLevel(ListOrgDepth(iI)) + 1
'       If iI = iIndex Then
'           For iJ = 1 To (MAX_NUM_DEPTH - 1)
'               If iLevel(iJ) = 0 Then
'                   Exit For
'               End If
'               If iJ = 1 Then
'                   ListOrgSize(iI) = ListOrgSize(iI) + " "
'               Else
'                   ListOrgSize(iI) = ListOrgSize(iI) + "-"
'               End If
'               ListOrgSize(iI) = ListOrgSize(iI) + Str(iLevel(iJ))
'           Next iJ
'       End If
'       ListOrgArray(iI) = Space(ListOrgDepth(iI) * 2) + ListOrgSize(iI)
        ListOrgArray(iI) = MakeListOrgItem(iI)
    Next iI

    DlgListBoxArray iListOrgID, ListOrgArray

Exit_InsertItem:

    InsertItem = ListOrgCount

End Function

Function DeleteItem(iIndex)

    Dim iListOrgID      As Integer
    Dim iC              As Integer
    Dim iI              As Integer
  ReDim ListOrgArray(0) As String

    iListOrgID = DlgControlId("ListOrg")
    iC         = DlgListBoxArray(iListOrgID)

    If iIndex < 0 Or iIndex >= iC Then
        Goto Exit_DeleteItem
    End If

    If iIndex < iC - 1 Then '마지막 아이템이 아니면...
        For iI = iIndex To iC - 2
            ListOrgDepth(iI)   = ListOrgDepth(iI + 1)
            ListOrgSize(iI)    = ListOrgSize(iI + 1)
            ListOrgContent(iI) = ListOrgContent(iI + 1)
        Next iI
    End If

    ListOrgCount = iC - 1

    If iC < 2 Then '아이템이 하나라면 리스트박스를 refresh 못한다.
        Goto Exit_DeleteItem
    End If

    ReDim ListOrgArray(iC - 2)

    For iI = 0 To iC - 2
'       ListOrgArray(iI) = Space(ListOrgDepth(iI) * 2) + ListOrgSize(iI)
        ListOrgArray(iI) = MakeListOrgItem(iI)
    Next iI

    DlgListBoxArray iListOrgID, ListOrgArray

Exit_DeleteItem:

    If ListOrgSelect >= ListOrgCount Then
        ListOrgSelect = ListOrgCount - 1
    End If
    DeleteItem = ListOrgCount

End Function

Function RecurseMove(iI, iD)

    Dim iJ  As Integer
    Dim dmy As Integer

    If ListOrgOwn(iI, 0) > 0 Then
        For iJ = 1 To ListOrgOwn(iI, 0)
            dmy = RecurseMove(ListOrgOwn(iI, iJ), iD)
        Next iJ
    End If

    ListOrgPos(iI) = ListOrgPos(iI) + iD
    If ListOrgPrg(ListOrgDepth(iI)) < ListOrgPos(iI) + AreaX Then
        ListOrgPrg(ListOrgDepth(iI)) = ListOrgPos(iI) + AreaX
    End If

    RecurseMove = 1

End Function

Function RecurseDraw(iI)

    Dim iJ  As Integer
    Dim dmy As Integer

    If ListOrgOwn(iI, 0) > 0 Then

    For iJ = 1 To ListOrgOwn(iI, 0)
        dmy = RecurseDraw(ListOrgOwn(iI, iJ))
    Next iJ

    ListOrgPos(iI) = (ListOrgPos(ListOrgOwn(iI, 1)) + ListOrgPos(ListOrgOwn(iI, ListOrgOwn(iI, 0)))) / 2

    If ListOrgPos(iI) < ListOrgPrg(ListOrgDepth(iI)) Then
        dmy = RecurseMove(iI, ListOrgPrg(ListOrgDepth(iI)) - ListOrgPos(iI))
    End If

    Else


    ListOrgPos(iI) = ListOrgPrg(ListOrgDepth(iI))

    End If

    If ListOrgPrg(ListOrgDepth(iI)) < ListOrgPos(iI) + AreaX Then
        ListOrgPrg(ListOrgDepth(iI)) = ListOrgPos(iI) + AreaX
    End If

    RecurseDraw = 1

End Function

Function BeInSameParent(iI1 As Integer, iI2 As Integer) As Integer

    Dim iResult As Integer
    Dim iJ      As Integer
    Dim iK      As Integer
    Dim iL      As Integer

    iResult = 0
    For iJ = 0 To ListOrgCount - 1
        For iK = 1 To ListOrgOwn(iJ, 0)
            If ListOrgOwn(iJ, iK) = iI1 Then
                For iL = 1 To ListOrgOwn(iJ, 0)
                    If ListOrgOwn(iJ, iL) = iI2 Then
                        iResult = 1
                    End If
                Next iL
                Goto Exit_BeInSameParent
            End If
        Next iK
    Next iJ

Exit_BeInSameParent:

    BeInSameParent = iResult

End Function



Sub DrawOrg

    Dim iLoop           As Integer
    Dim xMaxPrg         As Long
    Dim dRate           As Double

    Dim strContent      As String
    Dim iHeight         As Integer
    Dim iHeightSum      As Integer

    Dim FrmTitle        As Integer
    Dim iFrame          As Integer
    Dim iFind           As Integer
'   Dim xLinker1        As Long
'   Dim yLinker1        As Long
'   Dim xLinker2        As Long
'   Dim yLinker2        As Long

    Dim iI              As Integer
    Dim iJ              As Integer
    Dim iK              As Integer

'타이틀
    If s_EnableTitle = 1 Then
        FrmTitle = Hun70.TextFrame(-1, g_sxTitle, g_syTitle, g_exTitle, g_eyTitle, 0, 0)
        dmy = Hun70.SelectFrame(-1, FrmTitle, 0)
        dmy = Hun70.VerticalAlignCentre(-1)
        dmy = Hun70.ParaAlignCentre(-1)
        s_strParam = e_strTitleFont(s_TitleFont)
        dmy = Hun70.Font(-1, s_strParam, 0)
        dmy = Hun70.FontSize(-1, e_iTitleSize(s_TitleSize))
        dmy = Hun70.Bold(-1, 1)
'       dmy = Hun70.Italic(-1, 1)
        dmy = Hun70.Shade(-1, 2)
        dmy = Hun70.MoveCaret(-1, FrmTitle, 1, 1)
        dmy = Hun70.TextForeColour(-1, e_iTitleColorR(s_TitleColor), e_iTitleColorG(s_TitleColor), e_iTitleColorB(s_TitleColor))
        dmy = Hun70.InsertString(-1, s_TitleText)
    End If

'로고
'   dmy = Hun70.Image(-1, 0, g_CurDir + "Slogo_k.gif", g_sxLogo, g_syLogo, g_exLogo, g_eyLogo)

'초기화
    For iI = 0 To MAX_NUM_DEPTH
        For iJ = 0 To MAX_NUM_CHILD
            ListOrgOwn(iI, iJ) = 0
        Next iJ
        ListOrgMaxHeight(iI) = 0
    Next iI

'자식 구하기
    For iI = 0 To ListOrgCount - 1
        For iJ = iI + 1 To ListOrgCount - 1
            If ListOrgDepth(iJ) = ListOrgDepth(iI) + 1 Then
                ListOrgOwn(iI, 0) = ListOrgOwn(iI, 0) + 1
                ListOrgOwn(iI, ListOrgOwn(iI, 0)) = iJ
            Else
                If ListOrgDepth(iJ) <= ListOrgDepth(iI) Then
                    Exit For
                End If
            End If
        Next iJ
    Next iI

'최대 깊이 계산 / 그 깊이에서 최대 높이 계산.
    ListOrgMaxDepth = 0
    For iI = 0 To ListOrgCount - 1

        If ListOrgSizeEnable(iI) = 1 Then
            iHeight = e_iFrameSize(ListOrgSize(iI))
        Else
            '다시 계산한다.
            strContent = ListOrgContent(iI)
            iHeight = 1
            For iJ = 1 To Len(strContent)
                If Mid(strContent, iJ, 1) = Chr(10) Then
                    iHeight = iHeight + 1
                End If
            Next iJ
        End If
        If iHeight > ListOrgMaxHeight(ListOrgDepth(iI)) Then
            ListOrgMaxHeight(ListOrgDepth(iI)) = iHeight
        End If

        If ListOrgDepth(iI) > ListOrgMaxDepth Then
            ListOrgMaxDepth = ListOrgDepth(iI)
        End If

    Next iI

'   축소시키려면...
'   g_wdOrgBrd = g_wdOrgBrd / 3
'   g_hgOrgBrd = g_hgOrgBrd / 3

'프레임 위치 계산
    '초기크기 계산
    If ListOrgCount > 1 Then
        AreaX = g_wdOrgBrd   / (ListOrgCount - 1)
    Else
        AreaX = g_wdOrgBrd
    End If
    BoxX  = AreaX * 0.8  'Box Margin
    GapX  = AreaX - BoxX
    If ListOrgCount > 1 Then
        AreaX = AreaX + GapX / (ListOrgCount - 1)
    Else
        AreaX = AreaX + GapX
    End If
    If ListOrgCount > 1 Then
        BoxX  = BoxX  + GapX / (ListOrgCount - 1)
    Else
        BoxX  = BoxX  + GapX
    End If
    GapX  = AreaX - BoxX

    AreaY = g_hgOrgBrd   / (ListOrgMaxDepth + 1)
    BoxY  = AreaY * 0.4  'Box Margin
    GapY  = AreaY - BoxY
    AreaY = AreaY + GapY / (ListOrgMaxDepth + 1)
    BoxY  = BoxY  + GapY / (ListOrgMaxDepth + 1)
    GapY  = AreaY - BoxY

    For iLoop = 1 To 2
        '초기화
        For iI = 0 To MAX_NUM_ITEM
            ListOrgPos(iI) = 0   'Item  Index
            ListOrgPrg(iI) = 0   'Depth Index
        Next iI

        dmy = RecurseDraw(0)

        '최대 너비 계산
        xMaxPrg = 0
        For iI = 0 To ListOrgMaxDepth
            If ListOrgPrg(iI) > xMaxPrg Then
                xMaxPrg = ListOrgPrg(iI)
            End If
        Next iI
        xMaxPrg = xMaxPrg - GapX

        '프레임 크기 재계산
        dRate = g_wdOrgBrd / xMaxPrg
        AreaX = AreaX * dRate
        BoxX  = BoxX  * dRate
        GapX  = AreaX - BoxX

    Next iLoop

    '높이 합계 계산.
    iHeightSum = 0
    For iI = 0 To ListOrgMaxDepth
        iHeightSum = iHeightSum + ListOrgMaxHeight(iI)
    Next iI
    StartY2(0) = g_syOrgBrd
    BoxY2(0)   = BoxY  + g_ShareY / iHeightSum * ListOrgMaxHeight(0)
    For iI = 1 To ListOrgMaxDepth
        StartY2(iI) = StartY2(iI - 1) + BoxY2(iI - 1) + GapY
        BoxY2(iI)  = BoxY  + g_ShareY / iHeightSum * ListOrgMaxHeight(iI)
    Next iI

'실제 위치 계산
    For iI = 0 To ListOrgCount - 1
        ListOrgPos(iI) = ListOrgPos(iI) + g_sxOrgBrd
    Next iI

'프레임과 텍스트
    For iI = 0 To ListOrgCount - 1

        iJ = ListOrgDepth(iI)
        ListOrgFrame(iI) = Hun70.TextFrame(-1, ListOrgPos(iI), StartY2(iJ), ListOrgPos(iI) + BoxX, StartY2(iJ) + BoxY2(iJ), 0, 0)

        If ListOrgContent(iI) <> "" Then
            dmy = Hun70.TextMode(-1)
            dmy = Hun70.MoveCaret(-1, ListOrgFrame(iI), 1, 1)
            strContent = ListOrgContent(iI)
            iK = MyInstr(strContent, "@")
            While MyInstr(strContent, "@") > 0
                iJ = MyInstr(strContent, "@")
                If Left(strContent, iJ - 1) <> "" Then
                    dmy = Hun70.InsertString(-1, Left(strContent, iJ - 1))
                End If
                Select Case Mid(strContent, iJ , 2)
                    Case "@R"
                        dmy = Hun70.TextForeColour(-1, 192, 0, 0)
                        dmy = Hun70.Bold(-1, 1)
                    Case "@G"
                        dmy = Hun70.TextForeColour(-1, 0, 192, 0)
                        dmy = Hun70.Bold(-1, 1)
                    Case "@B"
                        dmy = Hun70.TextForeColour(-1, 0, 0, 192)
                        dmy = Hun70.Bold(-1, 1)
                    Case "@N"
                        dmy = Hun70.TextForeColour(-1, 0, 0, 0)
                        dmy = Hun70.Bold(-1, 0)
                End Select
                strContent = Mid(strContent, iJ + 2)
                iK = MyInstr(strContent, "@")
            WEnd
            If strContent <> "" Then
                dmy = Hun70.InsertString(-1, strContent)
            End If
        End If

    Next iI

'프레임 속성
    dmy = Hun70.SelectFrame(-1, ListOrgFrame(0), 0)
    For iI = 1 To ListOrgCount - 1
        dmy = Hun70.SelectFrame(-1, ListOrgFrame(iI), 1)
    Next iI
'   If e_iFrameSColorR(s_FrameSColor) = -1 And e_iFrameSColorG(s_FrameSColor) = -1 And e_iFrameSColorB(s_FrameSColor) = -1 Then
    If s_Transparent = 1 Then
        dmy = Hun70.FrameBorderType(-1, 1)
        dmy = Hun70.FrameBorderFillType(-1, 0)
    Else
        If s_FrameShade = 0 Or s_Transparent = 1 Then
            If s_FrameType = 0 Then
                dmy = Hun70.FrameBorderType(-1, 1)
            Else
                dmy = Hun70.FrameBorderType(-1, 30)
            End If
        Else
            dmy = Hun70.FrameBorderType(-1, e_iFrameType(s_FrameType))
        End If
        If s_FrameGradient = 1 Then
            dmy = Hun70.FrameBorderFillType(-1, 23)
        Else
            dmy = Hun70.FrameBorderFillType(-1, 1)
        End If
    End If
    dmy = Hun70.FrameBorderLineType(-1, 1)
    dmy = Hun70.FrameBorderFillPattern(-1, 2)
    dmy = Hun70.FrameBorderFillColour(-1, e_iFrameSColorR(s_FrameSColor), e_iFrameSColorG(s_FrameSColor), e_iFrameSColorB(s_FrameSColor))
    If s_FrameGradient = 1 Then
        dmy = Hun70.FrameGradientEndColour(-1, e_iFrameEColorR(s_FrameEColor), e_iFrameEColorG(s_FrameEColor), e_iFrameEColorB(s_FrameEColor))
'       dmy = Hun70.FrameGradientSlope(-1, 45)
'       dmy = Hun70.FrameGradientAxis(-1, 50, 50)
    End If
    If s_FrameShade = 1 And s_Transparent = 0 Then
        dmy = Hun70.FrameShadeSize(-1, 50, 50)
        dmy = Hun70.FrameShadePattern(-1, 2)
        dmy = Hun70.FrameShadeColour(-1, 128, 128, 128)
    End If
    dmy = Hun70.VerticalAlignCentre(-1)
    dmy = Hun70.ParaAlignCentre(-1)
    dmy = Hun70.Font(-1, "굴림", 0)
    dmy = Hun70.FontSize(-1, CLng(PtToTwips(CDbl(12))))
'   dmy = Hun70.TextFrameAutoSize(-1, 0)

'조직 연결
    If s_EnableLink = 1 Then
        For iI = 0 To ListOrgCount - 1
            iFind = 0

            'iI의 부모 아이템을 찾는다
            For iJ = 0 To ListOrgCount - 1

                'iJ의 자식 아이템을 조사한다
                For iK = 1 To ListOrgOwn(iJ, 0)

                    'iJ는 부모, iI는 자식
                    If ListOrgOwn(iJ, iK) = iI Then

                        '링커를 이용하는 경우
                        dmy = Hun70.SelectFrame(-1, ListOrgFrame(iJ), 0)
                        dmy = Hun70.SelectFrame(-1, ListOrgFrame(iI), 1)
                        iFrame = Hun70.LinkFrames(-1, 3, 1)
                        dmy = Hun70.SelectFrame(-1, iFrame, 0)
                        dmy = Hun70.FrameBorderLineType(-1, e_iLinkType(s_LinkType))
                        dmy = Hun70.FrameBorderLineWidth(-1, e_iLinkWidth(s_LinkWidth))
                        dmy = Hun70.FrameBorderLineColour(-1, e_iLinkColorR(s_LinkColor), e_iLinkColorG(s_LinkColor), e_iLinkColorB(s_LinkColor))

                        '라인을 이용하는 경우
'                       xLinker1 = ListOrgPos(iJ) + BoxX / 2
'                       yLinker1 = g_syOrgBrd + ListOrgDepth(iJ) * AreaY + BoxY
'                       xLinker2 = ListOrgPos(iI) + BoxX / 2
'                       yLinker2 = g_syOrgBrd + ListOrgDepth(iI) * AreaY
'                       dmy = Hun70.Line(-1, xLinker1, yLinker1, xLinker1, (yLinker1 + yLinker2) / 2)
'                       dmy = Hun70.Line(-1, xLinker2, yLinker2, xLinker2, (yLinker1 + yLinker2) / 2)
'                       dmy = Hun70.Line(-1, xLinker1, (yLinker1 + yLinker2) / 2, xLinker2, (yLinker1 + yLinker2) / 2)

                        iFind = 1
                        '다음 아이템으로
                        Exit For   'To If iFind = 1 Then
                    End If

                Next iK

                If iFind = 1 Then
                    '다음 아이템으로
                    Exit For   'To Next iI
                End If

            Next iJ

        Next iI
    End If

    dmy = Hun70.ArrowMode(-1)

End Sub



Function MultiLineToSingleLine(strSource As String) As String

    Dim iC          As Integer
    Dim strTarget   As String
    Dim iI          As Integer
    Dim strChar     As String

    iC        = Len(strSource)
    strTarget = ""

    For iI = 1 To iC
        strChar = Mid(strSource, iI, 1)
        If strChar = Chr(10) Then
            strChar = "\r"
        End If
        If strChar = Chr(13) Then
            strChar = "\n"
        End If
        strTarget = strTarget + strChar
    Next iI

    MultiLineToSingleLine = strTarget

End Function

Function SingleLineToMultiLine(strSource As String) As String

    Dim iC          As Integer
    Dim strTarget   As String
    Dim iI          As Integer
    Dim strChar     As String

    iC        = Len(strSource)
    strTarget = ""

    For iI = 1 To iC
        strChar = Mid(strSource, iI, 1)
        If strChar = "\" And iI < iC Then
            iI = iI + 1
            strChar = Mid(strSource, iI, 1)
            If strChar = "r" Then
                strChar = Chr(10)
            End If
            If strChar = "n" Then
                strChar = Chr(13)
            End If
        End If
        strTarget = strTarget + strChar
    Next iI

    SingleLineToMultiLine = strTarget

End Function



Function OpenStyleFile(iFileNumber As Integer, iHeaderCheck As Integer, strStyleFilePath As String) As Integer

    Dim iResult     As Integer
    Dim strError    As String
    Dim bIOpen      As Integer
    Dim strBuffer   As String
    Dim iDepth      As Integer
    Dim strItem     As String
    Dim strValue    As String

	On Local Error Goto Fail_OpenStyleFile

    iResult = 1

    If iFileNumber = 0 Then
        If strStyleFilePath = "" Then
            strStyleFilePath = g_FileExt.FileDialog(1, "*.oty", "", "Organization style Files (*.oty)|*.oty|All Files (*.*)|*.*||")
        End If
        If strStyleFilePath = "" Then
            Goto Fail_OpenStyleFile
        End If
        If Dir(strStyleFilePath) = "" Then
            strError = "파일을 찾을 수 없습니다."
            Goto Fail_OpenStyleFile
        End If

        iFileNumber = 1
        Open strStyleFilePath For Input As #iFileNumber

        bIOpen = 1
    Else
        bIOpen = 0
    End If

    If iHeaderCheck = 1 Then

        Line Input #iFileNumber, strBuffer '"Owner=Hun70 Organization"
            GetItemAndValue strBuffer, iDepth, strItem, strValue
            If iDepth > 0 Or strItem <> "Owner" Or strValue <> "Hun70 Organization" Then
                strError = "포멧에러 : Owner"
                Goto Fail_OpenStyleFile
            End If

        Line Input #iFileNumber, strBuffer '"Description=" + strStyleFilePath
            GetItemAndValue strBuffer, iDepth, strItem, strValue
            If iDepth > 0 Or strItem <> "Description" Then
                strError = "포멧에러 : Description"
                Goto Fail_OpenStyleFile
            End If

        Line Input #iFileNumber, strBuffer 'Header Separator
            If strBuffer <> "" Then
                strError = "포멧에러 : Header Separator"
                Goto Fail_OpenStyleFile
            End If

    End If

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "EnableTitle" Then
            strError = "포멧에러 : EnableTitle"
            Goto Fail_OpenStyleFile
        End If
        s_EnableTitle = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "TitleText" Then
            strError = "포멧에러 : TitleText"
            Goto Fail_OpenStyleFile
        End If
        s_TitleText = strValue

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "TitleFont" Then
            strError = "포멧에러 : TitleFont"
            Goto Fail_OpenStyleFile
        End If
        s_TitleFont = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "TitleSize" Then
            strError = "포멧에러 : TitleSize"
            Goto Fail_OpenStyleFile
        End If
        s_TitleSize = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "TitleColor" Then
            strError = "포멧에러 : TitleColor"
            Goto Fail_OpenStyleFile
        End If
        s_TitleColor = 1
        e_iTitleColorR(s_TitleColor) = Val(Mid(strValue, 1, 3))
        e_iTitleColorG(s_TitleColor) = Val(Mid(strValue, 4, 3))
        e_iTitleColorB(s_TitleColor) = Val(Mid(strValue, 7, 3))

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "FrameType" Then
            strError = "포멧에러 : FrameType"
            Goto Fail_OpenStyleFile
        End If
        s_FrameType = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "Transparent" Then
            strError = "포멧에러 : Transparent"
            Goto Fail_OpenStyleFile
        End If
        s_Transparent = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "FrameSColor" Then
            strError = "포멧에러 : FrameSColor"
            Goto Fail_OpenStyleFile
        End If
        s_FrameSColor = 1
        e_iFrameSColorR(s_FrameSColor) = Val(Mid(strValue, 1, 3))
        e_iFrameSColorG(s_FrameSColor) = Val(Mid(strValue, 4, 3))
        e_iFrameSColorB(s_FrameSColor) = Val(Mid(strValue, 7, 3))

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "FrameEColor" Then
            strError = "포멧에러 : FrameEColor"
            Goto Fail_OpenStyleFile
        End If
        s_FrameEColor = 1
        e_iFrameEColorR(s_FrameEColor) = Val(Mid(strValue, 1, 3))
        e_iFrameEColorG(s_FrameEColor) = Val(Mid(strValue, 4, 3))
        e_iFrameEColorB(s_FrameEColor) = Val(Mid(strValue, 7, 3))

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "FrameGradient" Then
            strError = "포멧에러 : FrameGradient"
            Goto Fail_OpenStyleFile
        End If
        s_FrameGradient = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "FrameShade" Then
            strError = "포멧에러 : FrameShade"
            Goto Fail_OpenStyleFile
        End If
        s_FrameShade = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "EnableLink" Then
            strError = "포멧에러 : EnableLink"
            Goto Fail_OpenStyleFile
        End If
        s_EnableLink = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "LinkType" Then
            strError = "포멧에러 : LinkType"
            Goto Fail_OpenStyleFile
        End If
        s_LinkType = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "LinkWidth" Then
            strError = "포멧에러 : LinkWidth"
            Goto Fail_OpenStyleFile
        End If
        s_LinkWidth = Val(strValue)

    Line Input #iFileNumber, strBuffer
        GetItemAndValue strBuffer, iDepth, strItem, strValue
        If iDepth > 0 Or strItem <> "LinkColor" Then
            strError = "포멧에러 : LinkColor"
            Goto Fail_OpenStyleFile
        End If
        s_LinkColor = 1
        e_iLinkColorR(s_LinkColor) = Val(Mid(strValue, 1, 3))
        e_iLinkColorG(s_LinkColor) = Val(Mid(strValue, 4, 3))
        e_iLinkColorB(s_LinkColor) = Val(Mid(strValue, 7, 3))

    If bIOpen = 1 Then
        s_StyleFile = strStyleFilePath
    End If
    Goto Exit_OpenStyleFile

Fail_OpenStyleFile:

    If strError <> "" Then
        MsgBox strError, 16, "조직도 만들기"
    End If

    iResult = 0

Exit_OpenStyleFile:

    If iFileNumber <> 0 And bIOpen = 1 Then
        Close #iFileNumber
    End If

    OpenStyleFile = iResult

End Function

Function SaveStyleFile(iFileNumber As Integer, iHeaderWrite As Integer, strStyleFilePath As String) As Integer

    Dim iResult     As Integer
    Dim strError    As String
    Dim bIOpen      As Integer

	On Local Error Goto Fail_SaveStyleFile

    iResult = 1

    If iFileNumber = 0 Then
        If strStyleFilePath = "" Then
            strStyleFilePath = g_FileExt.FileDialog(0, "*.oty", "", "Organization style Files (*.oty)|*.oty|All Files (*.*)|*.*||")
        End If
        If strStyleFilePath = "" Then
            strError = ""
            Goto Fail_SaveStyleFile
        End If

        iFileNumber = 1
        Open strStyleFilePath For Output As #iFileNumber

        bIOpen = 1
    Else
        bIOpen = 0
    End If

    If iHeaderWrite = 1 Then

        Print #iFileNumber, "Owner=Hun70 Organization"
        Print #iFileNumber, "Description=" + strStyleFilePath
        Print #iFileNumber, "" 'Header Separator

    End If

'   Print #iFileNumber, "Owner=Hun70 Organization"
'   Print #iFileNumber, "Description=" + strStyleFilePath
'   Print #iFileNumber, "" 'Header Separator

    Print #iFileNumber, "EnableTitle="   + LTrim(Str(s_EnableTitle))
    Print #iFileNumber, "TitleText="     + s_TitleText
    Print #iFileNumber, "TitleFont="     + LTrim(Str(s_TitleFont))
    Print #iFileNumber, "TitleSize="     + LTrim(Str(s_TitleSize))

'   Print #iFileNumber, "TitleColor="    + LTrim(Str(s_TitleColor))
	If e_iTitleColorR(s_TitleColor) = -1 And e_iTitleColorG(s_TitleColor) = -1 And e_iTitleColorB(s_TitleColor) = -1 Then
		Print #iFileNumber, "TitleColor=-01-01-01"
	Else
		Print #iFileNumber, "TitleColor="    + Right("000" + LTrim(Str(e_iTitleColorR(s_TitleColor))), 3) + Right("000" + LTrim(Str(e_iTitleColorG(s_TitleColor))), 3) + Right("000" + LTrim(Str(e_iTitleColorB(s_TitleColor))), 3)
	End If

    Print #iFileNumber, "FrameType="     + LTrim(Str(s_FrameType))
    Print #iFileNumber, "Transparent="   + LTrim(Str(s_Transparent))

'   Print #iFileNumber, "FrameSColor="   + LTrim(Str(s_FrameSColor))
	If e_iFrameSColorR(s_FrameSColor) = -1 And e_iFrameSColorG(s_FrameSColor) = -1 And e_iFrameSColorB(s_FrameSColor) = -1 Then
	    Print #iFileNumber, "FrameSColor=-01-01-01"
	Else
	    Print #iFileNumber, "FrameSColor="   + Right("000" + LTrim(Str(e_iFrameSColorR(s_FrameSColor))), 3) + Right("000" + LTrim(Str(e_iFrameSColorG(s_FrameSColor))), 3) + Right("000" + LTrim(Str(e_iFrameSColorB(s_FrameSColor))), 3)
	End If
'   Print #iFileNumber, "FrameEColor="   + LTrim(Str(s_FrameEColor))
	If e_iFrameEColorR(s_FrameEColor) = -1 And e_iFrameEColorG(s_FrameEColor) = -1 And e_iFrameEColorB(s_FrameEColor) = -1 Then
		Print #iFileNumber, "FrameEColor=-01-01-01"
	Else
		Print #iFileNumber, "FrameEColor="   + Right("000" + LTrim(Str(e_iFrameEColorR(s_FrameEColor))), 3) + Right("000" + LTrim(Str(e_iFrameEColorG(s_FrameEColor))), 3) + Right("000" + LTrim(Str(e_iFrameEColorB(s_FrameEColor))), 3)
	End If

    Print #iFileNumber, "FrameGradient=" + LTrim(Str(s_FrameGradient))
    Print #iFileNumber, "FrameShade="    + LTrim(Str(s_FrameShade))
    Print #iFileNumber, "EnableLink="    + LTrim(Str(s_EnableLink))
    Print #iFileNumber, "LinkType="      + LTrim(Str(s_LinkType))
    Print #iFileNumber, "LinkWidth="     + LTrim(Str(s_LinkWidth))

'   Print #iFileNumber, "LinkColor="     + LTrim(Str(s_LinkColor))
	If e_iLinkColorR(s_LinkColor) = -1 And e_iLinkColorG(s_LinkColor) = -1 And e_iLinkColorB(s_LinkColor) = -1 Then
		Print #iFileNumber, "LinkColor=-01-01-01"
	Else
		Print #iFileNumber, "LinkColor="     + Right("000" + LTrim(Str(e_iLinkColorR(s_LinkColor))), 3) + Right("000" + LTrim(Str(e_iLinkColorG(s_LinkColor))), 3) + Right("000" + LTrim(Str(e_iLinkColorB(s_LinkColor))), 3)
	End If

    If bIOpen = 1 Then
        s_StyleFile = strStyleFilePath
    End If
    Goto Exit_SaveStyleFile

Fail_SaveStyleFile:

    If strError <> "" Then
        MsgBox strError, 16, "조직도 만들기"
    End If

    iResult = 0

Exit_SaveStyleFile:

    If iFileNumber <> 0 And bIOpen = 1 Then
        Close #iFileNumber
    End If

    SaveStyleFile = iResult

End Function



Function OpenOrgFile(strOrgFilePath As String) As Integer

    Dim iResult         As Integer
    Dim strError        As String
    Dim iFileNumber     As Integer
    Dim strBuffer       As String
    Dim iI              As Integer
'   Dim iJ              As Integer

	On Local Error Goto Fail_OpenOrgFile

    iResult     = 1
    iFileNumber = 0

    If strOrgFilePath = "" Then
        strOrgFilePath = g_FileExt.FileDialog(1, "*.org", "", "Organization Files (*.org)|*.org|All Files (*.*)|*.*||")
    End If

    If strOrgFilePath = "" Then
        strError = ""
        Goto Fail_OpenOrgFile
    End If
    If Dir(strOrgFilePath) = "" Then
        strError = "파일을 찾을 수 없습니다."
        Goto Fail_OpenOrgFile
    End If

    iFileNumber = 1
    Open strOrgFilePath For Input As #iFileNumber

    If OpenStyleFile(iFileNumber, 1, strOrgFilePath) = 0 Then
        strError = ""
        Goto Fail_OpenOrgFile
    End If

'   Line Input #iFileNumber, s_StyleFile

    ListOrgCount = 0
    iI           = 0
    strBuffer    = "ListOrgData" 'Dummy string

'   Do While (Not Eof(1)) And strBuffer <> ""
    Do While (Not Eof(1))

        ListOrgCount = ListOrgCount + 1

        Line Input #iFileNumber, strBuffer
            GetItemAndValue strBuffer, iDepth, strItem, strValue
            If iDepth > 0 Or strItem <> "Depth" Then
                strError = "포멧에러[#" + LTrim(Str(ListOrgCount)) + "] : Depth"
                Goto Fail_OpenOrgFile
            End If
            ListOrgDepth(iI) = Val(strValue)

        Line Input #iFileNumber, strBuffer
            GetItemAndValue strBuffer, iDepth, strItem, strValue
            If iDepth > 0 Or strItem <> "SizeEnable" Then
                strError = "포멧에러[#" + LTrim(Str(ListOrgCount)) + "] : SizeEnable"
                Goto Fail_OpenOrgFile
            End If
            ListOrgSizeEnable(iI) = Val(strValue)

        Line Input #iFileNumber, strBuffer
            GetItemAndValue strBuffer, iDepth, strItem, strValue
            If iDepth > 0 Or strItem <> "Size" Then
                strError = "포멧에러[#" + LTrim(Str(ListOrgCount)) + "] : Size"
                Goto Fail_OpenOrgFile
            End If
            ListOrgSize(iI) = Val(strValue) 'index가 아닌 size.

'           For iJ = 0 To E_COUNT_iFrameSize
'               If e_iFrameSize(iJ) >= ListOrgSize(iI) Then
'                   ListOrgSize(iI) = iJ 'index로 변환.
'                   Exit For
'               End If
'           Next iJ

        Line Input #iFileNumber, strBuffer
            GetItemAndValue strBuffer, iDepth, strItem, strValue
            If iDepth > 0 Or strItem <> "Content" Then
                strError = "포멧에러[#" + LTrim(Str(ListOrgCount)) + "] : Content"
                Goto Fail_OpenOrgFile
            End If
            ListOrgContent(iI) = SingleLineToMultiLine(strValue)

        iI = iI + 1

    Loop

    ListOrgSelect = 0

    'must be reset.

'   If s_StyleFile <> "" Then
'       dmy = OpenStyleFile(0, 1, s_StyleFile)
'   End If

    Goto Exit_OpenOrgFile

Fail_OpenOrgFile:

    If strError <> "" Then
        MsgBox strError, 16, "조직도 만들기"
    End If

    iResult = 0

Exit_OpenOrgFile:

    If iFileNumber <> 0 Then
        Close #iFileNumber
    End If

    OpenOrgFile = iResult

End Function

Function SaveOrgFile(strOrgFilePath As String) As Integer

    Dim iResult         As Integer
    Dim strError        As String
    Dim iFileNumber     As Integer
    Dim strBuffer       As String
    Dim iI              As Integer

	On Local Error Goto Fail_SaveOrgFile

    iResult     = 1
    iFileNumber = 0

    If strOrgFilePath = "" Then
        strOrgFilePath = g_FileExt.FileDialog(0, "*.org", "", "Organization Files (*.org)|*.org|All Files (*.*)|*.*||")
    End If

    If strOrgFilePath = "" Then
        strError = ""
        Goto Fail_SaveOrgFile
    End If

    iFileNumber = 1
    Open strOrgFilePath For Output As #iFileNumber

    If SaveStyleFile(iFileNumber, 1, strOrgFilePath) = 0 Then
        strError = ""
        Goto Fail_SaveOrgFile
    End If

'   Print #iFileNumber, s_StyleFile

    For iI = 0 To ListOrgCount - 1
        Print #iFileNumber, "Depth="      + LTrim(Str(ListOrgDepth(iI)))
        Print #iFileNumber, "SizeEnable=" + LTrim(Str(ListOrgSizeEnable(iI)))
'       Print #iFileNumber, "Size="       + LTrim(Str(e_iFrameSize(ListOrgSize(iI))))
        Print #iFileNumber, "Size="       + LTrim(Str(ListOrgSize(iI)))
        strBuffer = MultiLineToSingleLine(ListOrgContent(iI))
        Print #iFileNumber, "Content="    + strBuffer
    Next iI

    Goto Exit_SaveOrgFile

Fail_SaveOrgFile:

    If strError <> "" Then
        MsgBox strError, 16, "조직도 만들기"
    End If

    iResult = 0

Exit_SaveOrgFile:

    If iFileNumber <> 0 Then
        Close #iFileNumber
    End If

    SaveOrgFile = iResult

End Function

Function OpenOrgFileNew() As Integer

    s_EnableTitle   = 1
    s_TitleText     = "훈민 워드 2000 조직도 만들기"
    s_TitleFont     = 2  '돋움
    s_TitleSize     = 10 '32pt.
    s_TitleColor    = 1
    e_iTitleColorR(s_TitleColor) = 128
    e_iTitleColorG(s_TitleColor) = 0
    e_iTitleColorB(s_TitleColor) = 128
    s_FrameType     = 0  '2 = 사각형
    s_Transparent   = 1
    s_FrameSColor   = 1
    e_iFrameSColorR(s_FrameSColor) = -1
    e_iFrameSColorG(s_FrameSColor) = -1
    e_iFrameSColorB(s_FrameSColor) = -1
    s_FrameEColor   = 1
    e_iFrameEColorR(s_FrameEColor) = -1
    e_iFrameEColorG(s_FrameEColor) = -1
    e_iFrameEColorB(s_FrameEColor) = -1
    s_FrameGradient = 0
    s_FrameShade    = 0
    s_EnableLink    = 1
    s_LinkType      = 0  '실선
    s_LinkWidth     = 0  '0.1㎜
    s_LinkColor     = 1
    e_iLinkColorR(s_LinkColor) = 0
    e_iLinkColorG(s_LinkColor) = 0
    e_iLinkColorB(s_LinkColor) = 0

    s_StyleFile     = ""

    ListOrgCount      = 1
    ListOrgDepth(0)   = 0
    ListOrgSize(0)    = 0
    ListOrgContent(0) = ""

    ListOrgSelect = 0

    'must be reset.

    OpenOrgFileNew = 1

End Function

