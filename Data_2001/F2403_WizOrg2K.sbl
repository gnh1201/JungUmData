'--------------------------------------------------------------------------------TTI Walk

Global b_Files(B_MAX_NUM_FILES)             As String
Global b_Count                              As Integer
Global b_Item(MAX_NUM_ITEM)                 As String
Global b_Value(MAX_NUM_ITEM)                As String
Global b_Parent(MAX_NUM_ITEM)               As Integer
Global b_Child(MAX_NUM_ITEM, MAX_NUM_CHILD) As Integer

Sub DirWalk(strPath As String)
   Dim strDir  As String
   Dim strFile As String
   strDir = CurDir
   If Right(CurDir, 1) <> "\" Then
      strDir = strDir + "\"
   End If
   If Instr(strPath, ":") = 0 And Instr(strPath, "\\") = 0 Then   'No drive specified.
      strPath = strDir + strPath
   End If
   b_Count = 0
   strFile = Dir(strPath)
   Do While strFile <> "" And b_Count <= B_MAX_NUM_FILE
      b_Files(b_Count) = strDir + strFile
      b_Count = b_Count + 1
      strFile = Dir
   Loop
End Sub

Sub GetItemAndValue(strLine As String, iDepth As Integer, strItem As String, strValue As String)
   Dim strLineCopy As String
   Dim iLenOrg     As Integer
   Dim iAssignPos  As Integer
   strLineCopy = strLine
   iLenOrg = Len(strLineCopy)
   strLineCopy = LTrim(strLineCopy)
   iDepth = iLenOrg - Len(strLineCopy)
   iAssignPos = Instr(strLineCopy, "=")
   If iAssignPos = 0 Then
      strItem  = RTrim(strLineCopy)
      strValue = ""
   Else
      strItem  = RTrim(Left(strLineCopy, iAssignPos - 1))
      strValue = RTrim(LTrim(Mid(strLineCopy, iAssignPos + 1)))
   End If
End Sub

Function CheckTtiHeader(strFile As String, strItem As String, strValue As String) As Integer
   Dim strItemCopy  As String
   Dim strValueCopy As String
   Dim iRetValue    As Integer
   Dim strLine      As String
   Dim iDepth       As Integer   'Header이므로 사용안함
   Dim strItemTmp   As String
   Dim strValueTmp  As String
   strItemCopy  = RTrim(LTrim(strItem))
   strValueCopy = RTrim(LTrim(strValue))
   iRetValue    = 0
   Open strFile for Input As #1
   Line Input #1, strLine
   Do While (Not Eof(1)) And strLine <> ""
      GetItemAndValue strLine, iDepth, strItemTmp, strValueTmp
      If strItemTmp = strItemCopy And strValueTmp = strValueCopy Then
         iRetValue = 1
         Exit Do
      Else
         Line Input #1, strLine
      End If
   Loop
   Close #1
   CheckTtiHeader = iRetValue
End Function

Function GetTtiHeaderValue(strFile As String, strItem As String) As String
   Dim strItemCopy  As String
   Dim strRetValue  As String
   Dim strLine      As String
   Dim iDepth       As Integer   'Header이므로 사용안함
   Dim strItemTmp   As String
   Dim strValueTmp  As String
   strItemCopy  = RTrim(LTrim(strItem))
   iRetValue    = 0
   Open strFile for Input As #1
   strLine = "Empty"
   Do While (Not Eof(1)) And strLine <> ""
      Line Input #1, strLine
      GetItemAndValue strLine, iDepth, strItemTmp, strValueTmp
      If strItemTmp = strItemCopy Then
         strRetValue = strValueTmp
         Exit Do
      End If
   Loop
   Close #1
   GetTtiHeaderValue = strRetValue
End Function

Function GetTtiBodyValue(strFile As String, strItem As String) As String
   Dim strItemCopy  As String
   Dim strRetValue  As String
   Dim strLine      As String
   Dim iDepth       As Integer   'Header이므로 사용안함
   Dim strItemTmp   As String
   Dim strValueTmp  As String
   strItemCopy  = RTrim(LTrim(strItem))
   iRetValue    = 0
   Open strFile for Input As #1
   strLine = "Empty"
   Do While (Not Eof(1)) And strLine <> ""   'Skip Header
      Line Input #1, strLine
   Loop
   If Not Eof(1) Then
      strLine = "Empty"
      Do While (Not Eof(1)) And strLine <> ""
         Line Input #1, strLine
         GetItemAndValue strLine, iDepth, strItemTmp, strValueTmp
         If strItemTmp = strItemCopy Then
            strRetValue = strValueTmp
            Exit Do
         End If
      Loop
   End If
   Close #1
   GetTtiBodyValue = strRetValue
End Function
'--------------------------------------------------------------------------------TTI Walk

'좌표계 변환
Function TwipsToMM(ValTwips As Double) As Double
    TwipsToMM = ValTwips * 254.0 / 14400.0
End Function

Function MMToTwips(ValMM As Double) As Double
    MMToTwips = ValMM * 14400.0 / 254.0
End Function

Function TwipsToPt(ValTwips As Double) As Double
    TwipsToPt = ValTwips / 20
End Function

Function PtToTwips(ValPt As Double) As Double
    PtToTwips = ValPt * 20
End Function



'페이퍼 정보
Sub GetPaperInfo()
    dmy = Hun70.GetPaperSize(-1, -1, g_wdPaper, g_hgPaper)
    dmy = Hun70.GetPaperMargins(-1, g_lmPaper, g_tmPaper, g_rmPaper, g_bmPaper)
    g_sxPage = g_lmPaper
    g_syPage = g_tmPaper
    g_exPage = g_wdPaper - g_rmPaper - 1
    g_eyPage = g_hgPaper - g_bmPaper - 1
    g_wdPage = g_wdPaper - g_lmPaper - g_rmPaper
    g_hgPage = g_hgPaper - g_tmPaper - g_bmPaper
End Sub

'페이지 정보
Sub SetPageInfo()
    If s_EnableTitle = 1 Then
        g_wdTitle    = g_wdPage
        g_hgTitle    = e_iTitleSize(s_TitleSize) * 1.5
        g_sxTitle    = g_sxPage
        g_syTitle    = g_syPage
        g_exTitle    = g_sxTitle + g_wdTitle - 1
        g_eyTitle    = g_syTitle + g_hgTitle - 1
        g_gpTitle    = 0
    End If
'   g_wdLogo     = CLng(MMToTwips(CDbl(35)))
'   g_hgLogo     = g_hgTitle - g_hgTitle / 10
'   g_sxLogo     = g_exPage - g_wdLogo + 1
'   g_syLogo     = g_syPage
'   g_exLogo     = g_sxLogo + g_wdLogo - 1
'   g_eyLogo     = g_syLogo + g_hgLogo - 1
'   g_gpLogo     = 0
    g_ShareY     = (g_hgPage - g_hgTitle) / 2
    g_wdOrgBrd   = g_wdPage
    g_hgOrgBrd   = g_hgPage - g_hgTitle - g_ShareY
    g_sxOrgBrd   = g_sxPage
    g_syOrgBrd   = g_syPage + g_hgTitle
    g_exOrgBrd   = g_sxOrgBrd + g_wdOrgBrd - 1
    g_eyOrgBrd   = g_syOrgBrd + g_hgOrgBrd - 1
    g_gpOrgBrd   = 0
End Sub



