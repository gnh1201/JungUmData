    Else
        iResult = OpenOrgFile("Org.org")
    End If
'   iResult = OpenOrgFile(g_Hun70Path + "Org.org")로 바꾸어야함!!!

    OpenOrgFilePrev = iResult

End Function



Sub UpdatePreview

    Dim iI As Integer

    dmy = g_CtrlExt.OrgSetItemCount(ListOrgCount)

    For iI = 0 To ListOrgCount - 1
        dmy = g_CtrlExt.OrgSetItemDepth(iI, ListOrgDepth(iI))
    Next iI

    dmy = g_CtrlExt.OrgRearrange()

End Sub

'Function ResetOrgStep1Dlg(iListOrgID As Integer, iTextSizeID As Integer) As Integer
Function ResetOrgStep1Dlg(iListOrgID As Integer, iChkFrameSizeID As Integer, iComboFrameSizeID As Integer) As Integer

  ReDim ListOrgArray(ListOrgCount - 1)  As String
    Dim iC                              As Integer
    Dim iI                              As Integer
    Dim strTemp                         As String

    '라벨에 깊이를 적용한다.
    For iI = 0 To ListOrgCount - 1
'       ListOrgArray(iI) = Space(ListOrgDepth(iI) * 2) + ListOrgSize(iI)
        ListOrgArray(iI) = MakeListOrgItem(iI)
    Next iI

    DlgListBoxArray iListOrgID       , ListOrgArray
    DlgValue        iListOrgID       , ListOrgSelect

    DlgValue        iChkFrameSizeID  , ListOrgSizeEnable(ListOrgSelect)
    DlgEnable       iComboFrameSizeID, ListOrgSizeEnable(ListOrgSelect)
'   DlgText         iTextSizeID      , ListOrgSize(ListOrgSelect)
    DlgValue        iComboFrameSizeID, ListOrgSize(ListOrgSelect)

    'validation check.
'       If ListOrgSizeEnable(ListOrgSelect) = 0 Then
'           iC = GetStringLineCount(ListOrgContent(ListOrgSelect))
'           For iI = 0 To E_COUNT_iFrameSize
'               If e_iFrameSize(iI) >= iC Then
'                   ListOrgSize(ListOrgSelect) = iI
'                   Exit For
'               End If
'           Next iI
'       End If

    DlgValue        iComboFrameSizeID, ListOrgSize(ListOrgSelect)
'   DlgText         iTextContentID   , ListOrgContent(ListOrgSelect)

    UpdatePreview

    dmy = g_CtrlExt.OrgSetSelectItem(ListOrgSelect)

    'g_CtrlExt.EditSetText(ListOrgContent(ListOrgSelect)) 이렇게 쓰면 에러.
    strTemp = ListOrgContent(ListOrgSelect)
    dmy = g_CtrlExt.EditSetText(strTemp)

End Function

Function OrgStep1DlgProc(identifier$, action, suppvalue)

    Dim iListOrgID          As Integer
    Dim iPicPreviewID       As Integer
    Dim iChkFrameSizeID     As Integer
'   Dim iTextSizeID         As Integer
    Dim iComboFrameSizeID   As Integer
    Dim iTextContentID      As Integer
    Dim iBtnInsertID        As Integer
    Dim iBtnDeleteID        As Integer
    Dim iBtn2InsertID       As Integer
    Dim iBtn3InsertID       As Integer
    Dim iBtn4InsertID       As Integer
'   Dim iPicLogoID          As Integer
    Dim iBtnNewID           As Integer
    Dim iBtnSampleID        As Integer
    Dim iBtnOpenID          As Integer
    Dim iBtnSaveID          As Integer
    Dim iBtnMakeID          As Integer
    Dim iBtnNextID          As Integer
    Dim iBtnExitID          As Integer
    Dim iBtnFunc1ID         As Integer
    Dim iBtnFunc2ID         As Integer
    Dim iBtnFunc3ID         As Integer

    Dim iDepthCurr          As Integer
    Dim iC                  As Integer
    Dim iI                  As Integer
    Dim iJ                  As Integer
    Dim iLoop               As Integer
    Dim strTemp             As String

    iListOrgID        = DlgControlId("ListOrg")
    iPicPreviewID     = DlgControlId("PicPreview")
    iChkFrameSizeID   = DlgControlId("ChkFrameSize")
'   iTextSizeID       = DlgControlId("TextSize")
    iComboFrameSizeID = DlgControlId("ComboFrameSize")
    iTextContentID    = DlgControlId("TextContent")
    iBtnInsertID      = DlgControlId("BtnInsert")
    iBtnDeleteID      = DlgControlId("BtnDelete")
    iBtn2InsertID     = DlgControlId("Btn2Insert")
    iBtn3InsertID     = DlgControlId("Btn3Insert")
    iBtn4InsertID     = DlgControlId("Btn4Insert")
'   iPicLogoID        = DlgControlId("PicLogo")
    iBtnNewID         = DlgControlId("BtnNew")
    iBtnSampleID      = DlgControlId("BtnSample")
    iBtnOpenID        = DlgControlId("BtnOpen")
    iBtnSaveID        = DlgControlId("BtnSave")
    iBtnMakeID        = DlgControlId("BtnMake")
    iBtnNextID        = DlgControlId("BtnNext")
    iBtnExitID        = DlgControlId("BtnExit")
    iBtnFunc1ID       = DlgControlId("BtnFunc1")
    iBtnFunc2ID       = DlgControlId("BtnFunc2")
    iBtnFunc3ID       = DlgControlId("BtnFunc3")

    OrgStep1DlgProc = 1

    Select Case action

        Case 1

            dmy = g_CtrlExt.OrgCreate ("조직도 만들기", iPicPreviewID  + 11, 0, 0, 0, 0)
            dmy = g_CtrlExt.OrgSetReflectWnd (iListOrgID  + 11, "ListBox")
            dmy = g_CtrlExt.EditCreate("조직도 만들기", iTextContentID + 11, 0, 0, 0, 0)
            dmy = g_CtrlExt.EditSetReflectWnd(iBtnFunc1ID + 11, "Button")
            DlgVisible iPicPreviewID , 0
            DlgVisible iTextContentID, 0
            DlgVisible iBtnFunc1ID   , 0
            DlgVisible iBtnFunc2ID   , 0
            DlgVisible iBtnFunc3ID   , 0

            DlgListBoxArray iComboFrameSizeID, e_strFrameSize

            dmy = ResetOrgStep1Dlg(iListOrgID, iChkFrameSizeID, iComboFrameSizeID)
            '이렇게 나눈 이유는 OpenOrgFileXXX의 파라메터로 control id를 주기가 지저분했기 때문.

        Case 2

            '리스트박스 아이템 선택
            If identifier$ = "ListOrg" Then
                ListOrgSelect = suppvalue
                DlgValue  iChkFrameSizeID  , ListOrgSizeEnable(ListOrgSelect)
                DlgEnable iComboFrameSizeID, ListOrgSizeEnable(ListOrgSelect)
'               DlgText   iTextSizeID      , ListOrgSize(ListOrgSelect)
                DlgValue  iComboFrameSizeID, ListOrgSize(ListOrgSelect)
'               DlgText   iTextContentID   , ListOrgContent(ListOrgSelect)
                dmy = g_CtrlExt.OrgSetSelectItem(ListOrgSelect)
                strTemp = ListOrgContent(ListOrgSelect) '왜 이렇게 해야 되는가?
                dmy = g_CtrlExt.EditSetText(strTemp)
            End If

            If identifier$ = "ChkFrameSize" Then
                ListOrgSizeEnable(ListOrgSelect) = DlgValue(iChkFrameSizeID)
                DlgEnable iComboFrameSizeID, ListOrgSizeEnable(ListOrgSelect)

'               If ListOrgSizeEnable(ListOrgSelect) = 0 Then
'                   iC = GetStringLineCount(ListOrgContent(ListOrgSelect))
'                   iJ = 0
'                   For iI = 0 To E_COUNT_iFrameSize
'                       If e_iFrameSize(iI) >= iC Then
'                           ListOrgSize(ListOrgSelect) = iI
'                           Exit For
'                       End If
'                   Next iI
'                   DlgValue iComboFrameSizeID, ListOrgSize(ListOrgSelect)
'               End If
            End If
            If identifier$ = "ComboFrameSize" Then
                ListOrgSize(ListOrgSelect) = DlgValue(iComboFrameSizeID)
            End If

            If identifier$ = "BtnInsert" Or identifier$ = "Btn2Insert" Or identifier$ = "Btn3Insert" Or identifier$ = "Btn4Insert" Then
                '아이템 갯수의 최대치 체크
                ListOrgCount = DlgListBoxArray(iListOrgID)
                If ListOrgCount >= MAX_NUM_ITEM Then
                    Goto Exit_OrgStep1DlgProc
                End If

                '반복 횟수
                If identifier$ = "BtnInsert"  Then
                    iLoop = 1
                End If
                If identifier$ = "Btn2Insert" Then
                    iLoop = 2
                End If
                If identifier$ = "Btn3Insert" Then
                    iLoop = 3
                End If
                If identifier$ = "Btn4Insert" Then
                    iLoop = 4
                End If

                ListOrgSelect = DlgValue(iListOrgID)
                '현재 선택된 아이템의 깊이
                iDepthCurr    = ListOrgDepth(ListOrgSelect)

                For iI = ListOrgSelect + 1 To ListOrgCount - 1
                    '삽입될 아이템의 위치 결정
                    If ListOrgDepth(iI) <= iDepthCurr Then
                        For iJ = 1 To iLoop
                            dmy = InsertItem(iI + iJ - 1, iDepthCurr + 1, "아이템", "")
                        Next iJ
                        Goto Step_End_Insert
                    End If
                Next iI

                For iJ = 1 To iLoop
                    '마지막 위치에 추가
                    iI = ListOrgCount
                    dmy = InsertItem(iI, iDepthCurr + 1, "아이템", "")
                Next iJ

Step_End_Insert:

                ListOrgCount = DlgListBoxArray(iListOrgID)
                UpdatePreview

            End If

            If identifier$ = "BtnDelete" Then
                '루트아이템은 삭제할 수 없다. 아이템 갯수의 최소치 체크.
                ListOrgSelect = DlgValue(iListOrgID)
                If ListOrgSelect = 0 Then
                    Goto Exit_OrgStep1DlgProc
                End If

                ListOrgCount = DlgListBoxArray(iListOrgID)
                iDepthCurr   = ListOrgDepth(ListOrgSelect)

                For iI = ListOrgSelect To ListOrgCount - 1
                    '대상 아이템의 깊이가 같거나 현재위치가 마지막 아이템을 넘었을 때(?)
                    If ListOrgDepth(ListOrgSelect) <= iDepthCurr And iI > ListOrgSelect Then
                        Exit For 'For iI
                    End If
                    DeleteItem(ListOrgSelect)
                    'ListOrgSelect값은 다음 아이템을 가르킨다.
                Next iI

                ListOrgCount = DlgListBoxArray(iListOrgID)
                If ListOrgSelect >= ListOrgCount Then
                    ListOrgSelect = ListOrgCount - 1
                End If
                DlgValue iListOrgID, ListOrgSelect

                dmy = g_CtrlExt.OrgSetSelectItem(ListOrgSelect)
                UpdatePreview

            End If

            If identifier$ = "BtnNew" Then
                dmy = OpenOrgFileNew()
                dmy = ResetOrgStep1Dlg(iListOrgID, iChkFrameSizeID, iComboFrameSizeID)
            End If
            If identifier$ = "BtnSample" Then
                dmy = OpenOrgFileSample()
                dmy = ResetOrgStep1Dlg(iListOrgID, iChkFrameSizeID, iComboFrameSizeID)
            End If
            If identifier$ = "BtnOpen" Then
                dmy = OpenOrgFile("")
                dmy = ResetOrgStep1Dlg(iListOrgID, iChkFrameSizeID, iComboFrameSizeID)
            End If
            If identifier$ = "BtnSave" Then
                dmy = SaveOrgFile("")
                dmy = ResetOrgStep1Dlg(iListOrgID, iChkFrameSizeID, iComboFrameSizeID)
            End If
            If identifier$ = "BtnMake" Then
                dmy = g_CtrlExt.OrgDestroyWindow()
                dmy = g_CtrlExt.EditDestroyWindow()
                g_Make     = 1
                g_Next     = 0
                OrgStep1DlgProc = 0
            End If
            If identifier$ = "BtnNext" Then
                dmy = g_CtrlExt.OrgDestroyWindow()
                dmy = g_CtrlExt.EditDestroyWindow()
                g_Make     = 0
                g_Next     = 1
                OrgStep1DlgProc = 0
            End If
            If identifier$ = "BtnExit" Then
                dmy = g_CtrlExt.OrgDestroyWindow()
                dmy = g_CtrlExt.EditDestroyWindow()
                g_Make     = 0
                g_Next     = 0
                OrgStep1DlgProc = 0
            End If
            If identifier$ = "BtnFunc1" Then
                ListOrgContent(ListOrgSelect) = g_CtrlExt.EditGetText()

'               If ListOrgSizeEnable(ListOrgSelect) = 0 Then 'disable되어있을 때만 재계산한다.
'                   iC = GetStringLineCount(ListOrgContent(ListOrgSelect))
'                   iJ = 0
'                   For iI = 0 To E_COUNT_iFrameSize
'                       If e_iFrameSize(iI) >= iC Then
'                           ListOrgSize(ListOrgSelect) = iI
'                           Exit For
'                       End If
'                   Next iI
'                   DlgValue iComboFrameSizeID, ListOrgSize(ListOrgSelect)
'               End If
            End If
            If identifier$ = "BtnFunc2" Then
            End If
            If identifier$ = "BtnFunc3" Then
            End If

        Case 3

'           If identifier$ = "TextSize" Then
'               '아이템 배열 및 갯수의 설정
'               Redim Preserve ListOrgArray(ListOrgCount)
'               ListOrgCount = DlgListBoxArray(iListOrgID, ListOrgArray)

'               ListOrgSize(ListOrgSelect) = DlgText(iTextSizeID)

'               '라벨은 깊이가 있으므로 리스트박스 아이템을 재설정 한다.
'               ListOrgArray(ListOrgSelect) = Space(ListOrgDepth(ListOrgSelect) * 2) + ListOrgSize(ListOrgSelect)
'               DlgListBoxArray iListOrgID, ListOrgArray
'           End If

'           If identifier$ = "TextContent" Then
'               ListOrgContent(ListOrgSelect) = DlgText(iTextContentID)
'           End If

        Case 4
        Case 5

    End Select

Exit_OrgStep1DlgProc:

    '리스트박스 아이템의 선택상태를 유지한다. (Focus)
    If action = 2 Or action = 3 Then
        DlgValue iListOrgID, ListOrgSelect
    End If

End Function



Function ResetOrgStep2DlgTitle(iChkTitleID, iTextTitleID, iComboTitleFontID, iComboTitleSizeID, iComboTitleColorID, iPicTitleID As Integer) As Integer

    If iChkTitleID > -1 Then
        DlgValue  iChkTitleID       , s_EnableTitle
        DlgEnable iTextTitleID      , s_EnableTitle
        DlgEnable iComboTitleFontID , s_EnableTitle
        DlgEnable iComboTitleSizeID , s_EnableTitle
'       DlgEnable iComboTitleColorID, s_EnableTitle
        dmy = g_CtrlExt.ColorSetEnable(0, s_EnableTitle)
        dmy = g_CtrlExt.TitleSetEnable(s_EnableTitle)
    End If
    If iTextTitleID > -1 Then
        DlgText iTextTitleID, s_TitleText
        dmy = g_CtrlExt.TitleSetText(s_TitleText)
    End If
    If iComboTitleFontID > -1 Then
        DlgValue iComboTitleFontID, s_TitleFont
        s_strParam = e_strTitleFont(s_TitleFont)
        dmy = g_CtrlExt.TitleSetFont(s_strParam, e_iTitleSizePt(s_TitleSize))
    End If
    If iComboTitleSizeID > -1 Then
        DlgValue iComboTitleSizeID, s_TitleSize
        s_strParam = e_strTitleFont(s_TitleFont)
        dmy = g_CtrlExt.TitleSetFont(s_strParam, e_iTitleSizePt(s_TitleSize))
    End If
    If iComboTitleColorID > -1 Then
'       DlgValue iComboTitleColorID, s_TitleColor
        dmy = g_CtrlExt.ColorSetColor(0, e_iTitleColorR(s_TitleColor), e_iTitleColorG(s_TitleColor), e_iTitleColorB(s_TitleColor))
        dmy = g_CtrlExt.TitleSetColor(e_iTitleColorR(s_TitleColor), e_iTitleColorG(s_TitleColor), e_iTitleColorB(s_TitleColor))
    End If
    If iPicTitleID > -1 Then
    End If

    ResetOrgStep2DlgTitle = 1

End Function

Function ResetOrgStep2DlgFrame(iComboFrameTypeID, iComboFrameSColorID, iComboFrameEColorID, iChkGradientID, iChkShadeID, iPicFrameID As Integer) As Integer

    If iComboFrameTypeID > -1 Then
        DlgValue iComboFrameTypeID, s_FrameType
        dmy = g_CtrlExt.FrameSetType(e_iFrameType(s_FrameType))
    End If
    If iComboFrameSColorID > -1 Then
'       DlgValue iComboFrameSColorID, s_FrameSColor
        dmy = g_CtrlExt.ColorSetColor(1, e_iFrameSColorR(s_FrameSColor), e_iFrameSColorG(s_FrameSColor), e_iFrameSColorB(s_FrameSColor))
        dmy = g_CtrlExt.FrameSetSColor(e_iFrameSColorR(s_FrameSColor), e_iFrameSColorG(s_FrameSColor), e_iFrameSColorB(s_FrameSColor))
'exception code
        If s_FrameSColor = 0 Then
            s_Transparent = 1
'           DlgEnable iComboFrameEColorID, 0
            dmy = g_CtrlExt.ColorSetEnable(2, 0)
            DlgEnable iChkGradientID     , 0
            DlgEnable iChkShadeID        , 0
        Else
            s_TransParent = 0
'           DlgEnable iComboFrameEColorID, s_FrameGradient
            dmy = g_CtrlExt.ColorSetEnable(2, s_FrameGradient)
            DlgEnable iChkGradientID     , 1
            DlgEnable iChkShadeID        , 1
        End If
    End If
    If iComboFrameEColorID > -1 Then
'       DlgValue iComboFrameEColorID, s_FrameEColor
        dmy = g_CtrlExt.ColorSetColor(2, e_iFrameEColorR(s_FrameEColor), e_iFrameEColorG(s_FrameEColor), e_iFrameEColorB(s_FrameEColor))
        dmy = g_CtrlExt.FrameSetEColor(e_iFrameEColorR(s_FrameEColor), e_iFrameEColorG(s_FrameEColor), e_iFrameEColorB(s_FrameEColor))
    End If
    If iChkGradientID > -1 Then
        DlgValue  iChkGradientID     , s_FrameGradient
'       DlgEnable iComboFrameEColorID, s_FrameGradient
        dmy = g_CtrlExt.ColorSetEnable(2, s_FrameGradient)
        dmy = g_CtrlExt.FrameSetGradient(s_FrameGradient)
    End If
    If iChkShadeID > -1 Then
        DlgValue iChkShadeID, s_FrameShade
        dmy = g_CtrlExt.FrameSetShade(s_FrameShade)
    End If
    If iPicFrameID > -1 Then
    End If

    ResetOrgStep2DlgFrame = 1

End Function

Function ResetOrgStep2DlgLink(iChkLinkID, iComboLinkTypeID, iComboLinkWidthID, iComboLinkColorID, iPicLinkID As Integer) As Integer

    If iChkLinkID > 0 Then
        DlgValue  iChkLinkID       , s_EnableLink
        DlgEnable iComboLinkTypeID , s_EnableLink
        DlgEnable iComboLinkWidthID, s_EnableLink
'       DlgEnable iComboLinkColorID, s_EnableLink
        dmy = g_CtrlExt.ColorSetEnable(3, s_EnableLink)
        dmy = g_CtrlExt.LinkSetEnable(s_EnableLink)
    End If
    If iComboLinkTypeID > -1 Then
        DlgValue iComboLinkTypeID, s_LinkType
        dmy = g_CtrlExt.LinkSetType(e_iLinkType(s_LinkType))
    End If
    If iComboLinkWidthID > -1 Then
        DlgValue iComboLinkWidthiD, s_LinkWidth
        dmy = g_CtrlExt.LinkSetWidth(e_iLinkWidthPt(s_LinkWidth))
    End If
    If iComboLinkColorID > -1 Then
'       DlgValue iComboLinkColorID, s_LinkColor
        dmy = g_CtrlExt.ColorSetColor(3, e_iLinkColorR(s_LinkColor), e_iLinkColorG(s_LinkColor), e_iLinkColorB(s_LinkColor))
        dmy = g_CtrlExt.LinkSetColor(e_iLinkColorR(s_LinkColor), e_iLinkColorG(s_LinkColor), e_iLinkColorB(s_LinkColor))
    End If
    If iPicLinkID > -1 Then
    End If

    ResetOrgStep2DlgLink = 1

End Function

Function ResetOrgStep2DlgStyle(iTextStyleFileID As Integer)

    If iTextStyleFileID > -1 Then
        DlgText iTextStyleFileID, s_StyleFile
    End If

End Function

Function OrgStep2DlgProc(identifier$, action, suppvalue)

    Dim iChkTitleID         As Integer
    Dim iTextTitleID        As Integer
    Dim iComboTitleFontID   As Integer
    Dim iComboTitleSizeID   As Integer
    Dim iComboTitleColorID  As Integer
    Dim iPicTitleID         As Integer
    Dim iComboFrameTypeID   As Integer
    Dim iComboFrameSColorID As Integer
    Dim iComboFrameEColorID As Integer
    Dim iChkGradientID      As Integer
    Dim iChkShadeID         As Integer
    Dim iPicFrameID         As Integer
    Dim iChkLinkID          As Integer
    Dim iComboLinkTypeID    As Integer
    Dim iComboLinkWidthID   As Integer
    Dim iComboLinkColorID   As Integer
    Dim iPicLinkID          As Integer
    Dim iTextStyleFileID    As Integer
    Dim iBtnOpenStyleFileID As Integer
    Dim iBtnSaveStyleFileID As Integer
    Dim iBtnNewID           As Integer
    Dim iBtnSampleID        As Integer
    Dim iBtnOpenID          As Integer
    Dim iBtnSaveID          As Integer
    Dim iBtnMakeID          As Integer
    Dim iBtnPrevID          As Integer
    Dim iBtnExitID          As Integer

    iChkTitleID         = DlgControlId("ChkTitle")
    iTextTitleID        = DlgControlId("TextTitle")
    iComboTitleFontID   = DlgControlId("ComboTitleFont")
    iComboTitleSizeID   = DlgControlId("ComboTitleSize")
    iComboTitleColorID  = DlgControlId("ComboTitleColor")
    iPicTitleID         = DlgControlId("PicTitle")
    iComboFrameTypeID   = DlgControlId("ComboFrameType")
    iComboFrameSColorID = DlgControlId("ComboFrameSColor")
    iComboFrameEColorID = DlgControlId("ComboFrameEColor")
    iChkGradientID      = DlgControlId("ChkGradient")
    iChkShadeID         = DlgControlId("ChkShade")
    iPicFrameID         = DlgControlId("PicFrame")
    iChkLinkID          = DlgControlId("ChkLink")
    iComboLinkTypeID    = DlgControlId("ComboLinkType")
    iComboLinkWidthID   = DlgControlId("ComboLinkWidth")
    iComboLinkColorID   = DlgControlId("ComboLinkColor")
    iPicLinkID          = DlgControlId("PicLink")
    iTextStyleFileID    = DlgControlId("TextStyleFile")
    iBtnOpenStyleFileID = DlgControlId("BtnOpenStyleFile")
    iBtnSaveStyleFileID = DlgControlId("BtnSaveStyleFile")
    iBtnNewID           = DlgControlId("BtnNew")
    iBtnSampleID        = DlgControlId("BtnSample")
    iBtnOpenID          = DlgControlId("BtnOpen")
    iBtnSaveID          = DlgControlId("BtnSave")
    iBtnMakeID          = DlgControlId("BtnMake")
    iBtnPrevID          = DlgControlId("BtnPrev")
    iBtnExitID          = DlgControlId("BtnExit")

    OrgStep2DlgProc = 1

    Select Case action

        Case 1

            dmy = g_CtrlExt.TitleCreate   ("조직도 만들기", iPicTitleID         + 11, 0, 0, 0, 0)
            dmy = g_CtrlExt.FrameCreate   ("조직도 만들기", iPicFrameID         + 11, 0, 0, 0, 0)
            dmy = g_CtrlExt.LinkCreate    ("조직도 만들기", iPicLinkID          + 11, 0, 0, 0, 0)
            dmy = g_CtrlExt.ColorCreate(0, "조직도 만들기", iComboTitleColorID  + 11, 0, 0, 0, 0)
            dmy = g_CtrlExt.ColorSetReflectWnd(0, iComboTitleColorID  + 11, "ComboBox")
            dmy = g_CtrlExt.ColorCreate(1, "조직도 만들기", iComboFrameSColorID + 11, 0, 0, 0, 0)
            dmy = g_CtrlExt.ColorSetReflectWnd(1, iComboFrameSColorID + 11, "ComboBox")
            dmy = g_CtrlExt.ColorCreate(2, "조직도 만들기", iComboFrameEColorID + 11, 0, 0, 0, 0)
            dmy = g_CtrlExt.ColorSetReflectWnd(2, iComboFrameEColorID + 11, "ComboBox")
            dmy = g_CtrlExt.ColorCreate(3, "조직도 만들기", iComboLinkColorID   + 11, 0, 0, 0, 0)
            dmy = g_CtrlExt.ColorSetReflectWnd(3, iComboLinkColorID   + 11, "ComboBox")
            DlgVisible iPicTitleID        , 0
            DlgVisible iPicFrameID        , 0
            DlgVisible iPicLinkID         , 0
            DlgVisible iComboTitleColorID , 0
            DlgVisible iComboFrameSColorID, 0
            DlgVisible iComboFrameEColorID, 0
            DlgVisible iComboLinkColorID  , 0

            DlgListBoxArray iComboTitleFontID  , e_strTitleFont
            DlgListBoxArray iComboTitleSizeID  , e_strTitleSize
            DlgListBoxArray iComboTitleColorID , e_strTitleColor
            DlgListBoxArray iComboFrameTypeID  , e_strFrameType
            DlgListBoxArray iComboFrameSColorID, e_strFrameSColor
            DlgListBoxArray iComboFrameEColorID, e_strFrameEColor
            DlgListBoxArray iComboLinkTypeID   , e_strLinkType
            DlgListBoxArray iComboLinkWidthID  , e_strLinkWidth
            DlgListBoxArray iComboLinkColorID  , e_strLinkColor

            dmy = ResetOrgStep2DlgTitle(iChkTitleID, iTextTitleID, iComboTitleFontID, iComboTitleSizeID, iComboTitleColorID, iPicTitleID)
            dmy = ResetOrgStep2DlgFrame(iComboFrameTypeID, iComboFrameSColorID, iComboFrameEColorID, iChkGradientID, iChkShadeID, iPicFrameID)
            dmy = ResetOrgStep2DlgLink(iChkLinkID, iComboLinkTypeID, iComboLinkWidthID, iComboLinkColorID, iPicLinkID)
            dmy = ResetOrgStep2DlgStyle(iTextStyleFileID)

            DlgEnable iTextStyleFileID, 0

            DlgEnable iBtnNewID   , 1
            DlgEnable iBtnSampleID, 1
            DlgEnable iBtnOpenID  , 1
            DlgEnable iBtnSaveID  , 1
            DlgEnable iBtnMakeID  , 1
            DlgEnable iBtnPrevID  , 1
            DlgEnable iBtnExitID  , 1

        Case 2

            If identifier$ = "ChkTitle" Then
                s_EnableTitle = DlgValue(iChkTitleID)
                DlgEnable iTextTitleID      , s_EnableTitle
                DlgEnable iComboTitleFontID , s_EnableTitle
                DlgEnable iComboTitleSizeID , s_EnableTitle
'               DlgEnable iComboTitleColorID, s_EnableTitle
                dmy = g_CtrlExt.ColorSetEnable(0, s_EnableTitle)
                DlgEnable iPicTitleID       , s_EnableTitle
                dmy = g_CtrlExt.TitleSetEnable(s_EnableTitle)
            End If
            If identifier$ = "ComboTitleFont" Then
                s_TitleFont = DlgValue(iComboTitleFontID)
                s_strParam = e_strTitleFont(s_TitleFont)
                dmy = g_CtrlExt.TitleSetFont(s_strParam, e_iTitleSizePt(s_TitleSize))
            End If
            If identifier$ = "ComboTitleSize" Then
                 s_TitleSize = DlgValue(iComboTitleSizeID)
                s_strParam = e_strTitleFont(s_TitleFont)
                dmy = g_CtrlExt.TitleSetFont(s_strParam, e_iTitleSizePt(s_TitleSize))
            End If
            If identifier$ = "ComboTitleColor" Then
'               s_TitleColor = DlgValue(iComboTitleColorID)
'               dmy = g_CtrlExt.TitleSetColor(e_iTitleColorR(s_TitleColor), e_iTitleColorG(s_TitleColor), e_iTitleColorB(s_TitleColor))
                s_TitleColor = 1
                dmy = g_CtrlExt.ColorGetColor(0, e_iTitleColorR(s_TitleColor), e_iTitleColorG(s_TitleColor), e_iTitleColorB(s_TitleColor))
                dmy = g_CtrlExt.TitleSetColor(   e_iTitleColorR(s_TitleColor), e_iTitleColorG(s_TitleColor), e_iTitleColorB(s_TitleColor))
            End If
            If identifier$ = "ComboFrameType" Then
                s_FrameType = DlgValue(iComboFrameTypeID)
                dmy = g_CtrlExt.FrameSetType(e_iFrameType(s_FrameType))
            End If
            If identifier$ = "ComboFrameSColor" Then
'               s_FrameSColor = DlgValue(iComboFrameSColorID)
'               dmy = g_CtrlExt.FrameSetSColor(e_iFrameSColorR(s_FrameSColor), e_iFrameSColorG(s_FrameSColor), e_iFrameSColorB(s_FrameSColor))
                s_FrameSColor = 1
                dmy = g_CtrlExt.ColorGetColor (1, e_iFrameSColorR(s_FrameSColor), e_iFrameSColorG(s_FrameSColor), e_iFrameSColorB(s_FrameSColor))
                dmy = g_CtrlExt.FrameSetSColor(   e_iFrameSColorR(s_FrameSColor), e_iFrameSColorG(s_FrameSColor), e_iFrameSColorB(s_FrameSColor))
                If e_iFrameSColorR(s_FrameSColor) = -1 And e_iFrameSColorG(s_FrameSColor) = -1 And e_iFrameSColorB(s_FrameSColor) = -1 Then
                    s_Transparent = 1
'                   DlgEnable iComboFrameEColorID, 0
                    dmy = g_CtrlExt.ColorSetEnable(2, 0)
                    DlgEnable iChkGradientID     , 0
                    DlgEnable iChkShadeID        , 0
                Else
                    s_TransParent = 0
'                   DlgEnable iComboFrameEColorID, s_FrameGradient
                    dmy = g_CtrlExt.ColorSetEnable(2, s_FrameGradient)
                    DlgEnable iChkGradientID     , 1
                    DlgEnable iChkShadeID        , 1
                End If
            End If
            If identifier$ = "ComboFrameEColor" Then
'               s_FrameEColor = DlgValue(iComboFrameEColorID)
'               dmy = g_CtrlExt.FrameSetEColor(e_iFrameEColorR(s_FrameEColor), e_iFrameEColorG(s_FrameEColor), e_iFrameEColorB(s_FrameEColor))
                s_FrameEColor = 1
                dmy = g_CtrlExt.ColorGetColor (2, e_iFrameEColorR(s_FrameEColor), e_iFrameEColorG(s_FrameEColor), e_iFrameEColorB(s_FrameEColor))
                dmy = g_CtrlExt.FrameSetEColor(   e_iFrameEColorR(s_FrameEColor), e_iFrameEColorG(s_FrameEColor), e_iFrameEColorB(s_FrameEColor))
            End If
            If identifier$ = "ChkGradient" Then
                s_FrameGradient = DlgValue(iChkGradientID)
'               DlgEnable iComboFrameEColorID, s_FrameGradient
                dmy = g_CtrlExt.ColorSetEnable(2, s_FrameGradient)
                dmy = g_CtrlExt.FrameSetGradient(s_FrameGradient)
            End If
            If identifier$ = "ChkShade" Then
                s_FrameShade = DlgValue(iChkShadeID)
                dmy = g_CtrlExt.FrameSetShade(s_FrameShade)
            End If
            If identifier$ = "ChkLink" Then
                s_EnableLink = DlgValue(iChkLinkID)
                DlgEnable iComboLinkTypeID , s_EnableLink
                DlgEnable iComboLinkWidthID, s_EnableLink
'               DlgEnable iComboLinkColorID, s_EnableLink
                dmy = g_CtrlExt.ColorSetEnable(3, s_EnableLink)
                DlgEnable iPicLinkID       , s_EnableLink
                dmy = g_CtrlExt.LinkSetEnable(s_EnableLink)
            End If
            If identifier$ = "ComboLinkType" Then
                s_LinkType = DlgValue(iComboLinkTypeID)
                dmy = g_CtrlExt.LinkSetType(e_iLinkType(s_LinkType))
            End If
            If identifier$ = "ComboLinkWidth" Then
                s_LinkWidth = DlgValue(iComboLinkWidthID)
                dmy = g_CtrlExt.LinkSetWidth(e_iLinkWidthPt(s_LinkWidth))
            End If
            If identifier$ = "ComboLinkColor" Then
'               s_LinkColor = DlgValue(iComboLinkColorID)
'               dmy = g_CtrlExt.LinkSetColor(e_iLinkColorR(s_LinkColor), e_iLinkColorG(s_LinkColor), e_iLinkColorB(s_LinkColor))
                s_LinkColor = 1
                dmy = g_CtrlExt.ColorGetColor(3, e_iLinkColorR(s_LinkColor), e_iLinkColorG(s_LinkColor), e_iLinkColorB(s_LinkColor))
                dmy = g_CtrlExt.LinkSetColor (   e_iLinkColorR(s_LinkColor), e_iLinkColorG(s_LinkColor), e_iLinkColorB(s_LinkColor))
            End If

            If identifier$ = "BtnOpenStyleFile" Then
                dmy = OpenStyleFile(0, 1, "")
                dmy = ResetOrgStep2DlgTitle(iChkTitleID, iTextTitleID, iComboTitleFontID, iComboTitleSizeID, iComboTitleColorID, iPicTitleID)
                dmy = ResetOrgStep2DlgFrame(iComboFrameTypeID, iComboFrameSColorID, iComboFrameEColorID, iChkGradientID, iChkShadeID, iPicFrameID)
                dmy = ResetOrgStep2DlgLink(iChkLinkID, iComboLinkTypeID, iComboLinkWidthID, iComboLinkColorID, iPicLinkID)
                dmy = ResetOrgStep2DlgStyle(iTextStyleFileID)
            End If
            If identifier$ = "BtnSaveStyleFile" Then
                dmy = SaveStyleFile(0, 1, "")
                dmy = ResetOrgStep2DlgStyle(iTextStyleFileID)
            End If

            If identifier$ = "BtnNew" Then
                dmy = OpenOrgFileNew()
                dmy = ResetOrgStep2DlgTitle(iChkTitleID, iTextTitleID, iComboTitleFontID, iComboTitleSizeID, iComboTitleColorID, iPicTitleID)
                dmy = ResetOrgStep2DlgFrame(iComboFrameTypeID, iComboFrameSColorID, iComboFrameEColorID, iChkGradientID, iChkShadeID, iPicFrameID)
                dmy = ResetOrgStep2DlgLink(iChkLinkID, iComboLinkTypeID, iComboLinkWidthID, iComboLinkColorID, iPicLinkID)
                dmy = ResetOrgStep2DlgStyle(iTextStyleFileID)
            End If
            If identifier$ = "BtnSample" Then
                dmy = OpenOrgFileSample()
                dmy = ResetOrgStep2DlgTitle(iChkTitleID, iTextTitleID, iComboTitleFontID, iComboTitleSizeID, iComboTitleColorID, iPicTitleID)
                dmy = ResetOrgStep2DlgFrame(iComboFrameTypeID, iComboFrameSColorID, iComboFrameEColorID, iChkGradientID, iChkShadeID, iPicFrameID)
                dmy = ResetOrgStep2DlgLink(iChkLinkID, iComboLinkTypeID, iComboLinkWidthID, iComboLinkColorID, iPicLinkID)
                dmy = ResetOrgStep2DlgStyle(iTextStyleFileID)
            End If
            If identifier$ = "BtnOpen" Then
                dmy = OpenOrgFile("")
                dmy = ResetOrgStep2DlgTitle(iChkTitleID, iTextTitleID, iComboTitleFontID, iComboTitleSizeID, iComboTitleColorID, iPicTitleID)
                dmy = ResetOrgStep2DlgFrame(iComboFrameTypeID, iComboFrameSColorID, iComboFrameEColorID, iChkGradientID, iChkShadeID, iPicFrameID)
                dmy = ResetOrgStep2DlgLink(iChkLinkID, iComboLinkTypeID, iComboLinkWidthID, iComboLinkColorID, iPicLinkID)
                dmy = ResetOrgStep2DlgStyle(iTextStyleFileID)
            End If
            If identifier$ = "BtnSave" Then
                dmy = SaveOrgFile("")
            End If
            If identifier$ = "BtnMake" Then
                dmy = g_CtrlExt.TitleDestroyWindow()
                dmy = g_CtrlExt.FrameDestroyWindow()
                dmy = g_CtrlExt.LinkDestroyWindow()
                dmy = g_CtrlExt.ColorDestroyWindow(0)
                dmy = g_CtrlExt.ColorDestroyWindow(1)
                dmy = g_CtrlExt.ColorDestroyWindow(2)
                dmy = g_CtrlExt.ColorDestroyWindow(3)
                g_Make = 1
                g_Prev = 0
                OrgStep2DlgProc = 0
            End If
            If identifier$ = "BtnPrev" Then
                dmy = g_CtrlExt.TitleDestroyWindow()
                dmy = g_CtrlExt.FrameDestroyWindow()
                dmy = g_CtrlExt.LinkDestroyWindow()
                dmy = g_CtrlExt.ColorDestroyWindow(0)
                dmy = g_CtrlExt.ColorDestroyWindow(1)
                dmy = g_CtrlExt.ColorDestroyWindow(2)
                dmy = g_CtrlExt.ColorDestroyWindow(3)
                g_Make = 0
                g_Prev = 1
                OrgStep2DlgProc = 0
            End If
            If identifier$ = "BtnExit" Then
                dmy = g_CtrlExt.TitleDestroyWindow()
                dmy = g_CtrlExt.FrameDestroyWindow()
                dmy = g_CtrlExt.LinkDestroyWindow()
                dmy = g_CtrlExt.ColorDestroyWindow(0)
                dmy = g_CtrlExt.ColorDestroyWindow(1)
                dmy = g_CtrlExt.ColorDestroyWindow(2)
                dmy = g_CtrlExt.ColorDestroyWindow(3)
                g_Make = 0
                g_Prev = 0
                OrgStep2DlgProc = 0
            End If

        Case 3

            If identifier$ = "TextTitle" Then
                s_TitleText = DlgText(iTextTitleID)
                dmy = g_CtrlExt.TitleSetText(s_TitleText)
            End If
            If identifier$ = "TextStyleFile" Then
            End If

        Case 4
        Case 5

    End Select

End Function



Sub Main

    Dim iResult      As Integer
    Dim strCmd       As String
    Dim lFrameLeft   As Long
    Dim lFrameTop    As Long
    Dim lFrameRight  As Long
    Dim lFrameBottom As Long

    Set Hun70     = CreateObject("HUN70.IF")
    Set g_CtrlExt = CreateObject("HBAEXT2K.CTRLEXT")
    Set g_FileExt = CreateObject("HBAEXT2K.FILEEXT")

    '----------------------------------------
    ' Init system variable
    '----------------------------------------
    g_CurDir = CurDir
    If Right(g_CurDir, 1) <> "\" Then
        g_CurDir = g_CurDir + "\"
    End If

    Begin Dialog OrgStep1Dlg 280, 224, "조직도 만들기", .OrgStep1DlgProc
        Text          4,   4,  22,   8, "조직도"
        ListBox       4,  12,  80, 144, "가장처음"   , .ListOrg
        Text         88,   4,  28,   8, "미리보기"
        Picture      88,  12, 136, 139, "", 3        , .PicPreview
'       Text          4, 160,  16,   8, "크기"
        CheckBox      4, 160,  24,   8, "크기"       , .ChkFrameSize
'       TextBox       4, 168,  16,  12               , .TextSize
        DropComboBox  4, 169,  28,  64, ""           , .ComboFrameSize
        Text         36, 160,  16,   8, "내용"
        TextBox      36, 168, 188,  36               , .TextContent
        PushButton  228,  12,  48,  20, "삽입"       , .BtnInsert
        PushButton  228,  36,  48,  20, "삭제"       , .BtnDelete
        PushButton  228,  84,  48,  20, "두개 삽입"  , .Btn2Insert
        PushButton  228, 108,  48,  20, "세개 삽입"  , .Btn3Insert
        PushButton  228, 132,  48,  20, "네개 삽입"  , .Btn4Insert
'       Picture     228, 168,  48,  36, "Org.bmp", 0 , .PicLogo
        PushButton    0, 210,  40,  14, "새 조직도"  , .BtnNew
        PushButton   40, 210,  40,  14, "예제"       , .BtnSample
        PushButton   80, 210,  40,  14, "불러오기...", .BtnOpen
        PushButton  120, 210,  40,  14, "저장..."    , .BtnSave
        PushButton  160, 210,  40,  14, "만들기"     , .BtnMake
        PushButton  200, 210,  40,  14, "다음>"      , .BtnNext
        PushButton  240, 210,  40,  14, "종료"       , .BtnExit
        PushButton   88, 152,  44,  12, "기능버튼1"  , .BtnFunc1
        PushButton  132, 152,  44,  12, "기능버튼2"  , .BtnFunc2
        PushButton  176, 152,  44,  12, "기능버튼3"  , .BtnFunc3
        Text  228, 168, 48, 8, "@R - 적색", .TextHelpR
        Text  228, 176, 48, 8, "@G - 녹색", .TextHelpG
        Text  228, 184, 48, 8, "@B - 청색", .TextHelpB
        Text  228, 192, 48, 8, "@N - 흑색", .TextHelpN
    End Dialog

    Begin Dialog OrgStep2Dlg 280, 224, "조직도 만들기", .OrgStep2DlgProc
        CheckBox       2,  10,  24,  8, "제목"       , .ChkTitle
        TextBox       36,   8, 236, 12               , .TextTitle
        Text          12,  30,  16,  8, "서체"
        DropComboBox  36,  28,  65, 64, ""           , .ComboTitleFont
        Text         116,  30,  16,  8, "크기"
        DropComboBox 140,  28,  25, 64, ""           , .ComboTitleSize
        Text          12,  50,  16,  8, "색상"
        DropComboBox  36,  48,  49, 64, ""           , .ComboTitleColor
        Picture      172,  28, 100, 32, "", 0        , .PicTitle
        Text          12,  78,  16,  8, "틀"
        DropComboBox  36,  76,  49, 64, ""           , .ComboFrameType
        Text           8,  98,  28,  8, "시작색상"
        DropComboBox  36,  96,  49, 64, ""           , .ComboFrameSColor
        Text          12, 118,  22,  8, "끝색상"
        DropComboBox  36, 116,  49, 64, ""           , .ComboFrameEColor
        CheckBox     120,  80,  44,  8, "Gradient"   , .ChkGradient
        CheckBox     120, 100,  32,  8, "그림자"     , .ChkShade
        Picture      172,  76, 100, 52, "", 0        , .PicFrame
        CheckBox       2, 146,  30,  8, "연결선"     , .ChkLink
        DropComboBox  36, 144,  65, 64, ""           , .ComboLinkType
        Text         112, 146,  16,  8, "굵기"
        DropComboBox 136, 144,  29, 64, ""           , .ComboLinkWidth
        Text          12, 166,  16,  8, "색상"
        DropComboBox  36, 164,  49, 64, ""           , .ComboLinkColor
        Picture      172, 144, 100, 32, "", 0        , .PicLink
        Text           8, 190,  28,  8, "서식파일"
        TextBox       36, 188, 154, 12               , .TextStyleFile
        PushButton   190, 187,  40, 14, "불러오기...", .BtnOpenStyleFile
        PushButton   230, 187,  40, 14, "저장..."    , .BtnSaveStyleFile
        PushButton     0, 210,  40, 14, "새 조직도"  , .BtnNew
        PushButton    40, 210,  40, 14, "예제"       , .BtnSample
        PushButton    80, 210,  40, 14, "불러오기...", .BtnOpen
        PushButton   120, 210,  40, 14, "저장..."    , .BtnSave
        PushButton   160, 210,  40, 14, "만들기"     , .BtnMake
        PushButton   200, 210,  40, 14, "<이전"      , .BtnPrev
        PushButton   240, 210,  40, 14, "종료"       , .BtnExit
    End Dialog

    Dim DlgOrgStep1 As OrgStep1Dlg
    Dim DlgOrgStep2 As OrgStep2Dlg

    dmy = SetEnumVar()

    iResult = OpenOrgFilePrev()
    If iResult = 0 Then
        dmy = OpenOrgFileSample()
    End If

Step_DlgOrgStep1:

    Dialog DlgOrgStep1
    If g_Next = 1 Then
        Dialog DlgOrgStep2
        If g_Prev = 1 Then
            Goto Step_DlgOrgStep1
        End If
    End If
    If g_Make = 1 Then
'       dmy = Hun70.PaperSize(-1, 0, 0, 0, 1, 0)
'       dmy = Hun70.PaperSize(-1, 0, 0, 0, 0, 0)
'       dmy = Hun70.MaxHorizontalZoom()
        dmy = Hun70.MaxVerticalZoom()

        strCmd = Command
        strCmd = LTrim(RTrim(strCmd))
        If strCmd <> "" Then
            g_iMakeMode  = 1
            g_lMakeFrame = Val(strCmd)
            dmy = Hun70.GetPaperSize(-1, -1, g_wdPaper, g_hgPaper)

'           dmy = Hun70.GetPaperMargins(-1, g_lmPaper, g_tmPaper, g_rmPaper, g_bmPaper)
            dmy = Hun70.GetFrameRect(-1, g_lMakeFrame, lFrameLeft, lFrameTop, lFrameRight, lFrameBottom)
            g_lmPaper = lFrameLeft
            g_tmPaper = lFrameTop
            g_rmPaper = g_wdPaper - lFrameRight  - 1
            g_bmPaper = g_hgPaper - lFrameBottom - 1

            g_sxPage = g_lmPaper
            g_syPage = g_tmPaper
            g_exPage = g_wdPaper - g_rmPaper - 1
            g_eyPage = g_hgPaper - g_bmPaper - 1
            g_wdPage = g_wdPaper - g_lmPaper - g_rmPaper
            g_hgPage = g_hgPaper - g_tmPaper - g_bmPaper

            dmy = Hun70.DeleteFrame(-1, g_lMakeFrame)
        Else
            g_iMakeMode  = 0
            g_lMakeFrame = 0
            GetPaperInfo
        End If
                
        SetPageInfo
		dmy = Hun70.InitImportProc(-1, 0)
		dmy = Hun70.UpdateDisplay(-1, 0)
        DrawOrg
		dmy = Hun70.InitImportProc(-1, 1)
		dmy = Hun70.UpdateDisplay(-1, 1)
    End If

    dmy = SaveOrgFile("Org.org")

End Sub
