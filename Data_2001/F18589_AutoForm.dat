[AutoFormat]

;aa는 다음과 같다
;    A* B*  C*  D* E*
;	+--+----------+--+
;	|A1|    C1    |E1| *1 : header
;	+--+----------+--+
;	|  |          |  | *2 : top row in contents
;	|A3|    C3    |E3| *3 : contents
;	|  |          |  | *4 : bottom row in contents
;	+--+----------+--+
;	|A5|    C5    |E5| *5 : footer
;	+--+----------+--+ *6 : secondary row (번갈아 가면서 나오는 특성)
;	B* : left col in contents
;	D* : right col in contents

;x_An=aa,align
;(Align)
;	aa : 선택된 셀의 어느부분에 특성을 적용할 것인가를 결정
;	align : 왼쪽, 오른쪽, 가운데 맞춤
;		[left, right, center, justify]

;x_Bn=aa,border,b1,r,g,b
;(Border)
;	aa : 선택된 셀의 어느부분에 특성을 적용할 것인가를 결정
;	border : border의 선 위치
;		[top, bottom, left, right]
;	b1 : 선굵기 (1=thin, 2=medium, 5=thick, 6=double)
;	r,g,b : 선색상

;x_Fn=aa,r,g,b,f1
;(Font)
;	aa : 선택된 셀의 어느부분에 특성을 적용할 것인가를 결정
;	r,g,b : 글자의 색상
;	f1 : 밑줄여부 (underline, 0)

;x_Nn=aa,format
;(Number)
;	aa : 선택된 셀의 어느부분에 특성을 적용할 것인가를 결정
;	format : 숫자가 나타나는 형식
;		(general, currency, comma)

;x_Pn=aa,r,g,b
;(Pattern)
;	aa : 선택된 셀의 어느부분에 특성을 적용할 것인가를 결정
;	r,g,b : 바탕의 색상

;x_Wn=aa,format
;(Number)
;	aa : 선택된 셀의 어느부분에 특성을 적용할 것인가를 결정
;	format : 너비/높이에 대한 값
;		(default:기본값, fit:셀의 값에 맞게)

